#!/usr/bin/env bash
# Copyright 2026 Jack Lau
# SPDX-License-Identifier: Apache-2.0
#
# husk - storage-efficient git worktrees via content-keyed dependency sharing
# Modes: clone (CoW, default where supported) | hardlink | symlink | copy
# Portable: bash 3.2+, macOS + Linux. No dependencies beyond git + coreutils.
set -euo pipefail

HUSK_VERSION="0.1.0"
HUSK_STORE="${HUSK_STORE:-$HOME/.husk/store}"
HUSK_MODE="${HUSK_MODE:-auto}"
HUSK_REAP_DAYS="${HUSK_REAP_DAYS:-7}"
HUSK_LOCK_TIMEOUT="${HUSK_LOCK_TIMEOUT:-120}"

KNOWN_DIRS="node_modules .venv venv target vendor Pods"

# ---------- spawn budget ----------
# A new process is nearly free on Linux/macOS and brutally expensive here:
# measured at ~1,275 ms per exec and ~875 ms for a BARE `$(shell_function)` on an
# NTFS box with Defender inspecting every process creation. MSYS emulates fork
# with a real Windows process, so command substitution costs almost as much as
# running an external program. One `husk add` used to pay ~115 of them, which is
# why a 10-file dependency dir cost 149s and a 21,000-file one cost 162s: the
# tree was never what we were paying for.
#
# Two rules follow, and both are load-bearing:
#   1. Values that are invariant for the life of the process are computed once.
#   2. Helpers on the hot path ASSIGN to a global instead of printing, because
#      `x=$(helper)` forks even when the helper does nothing but expand a string.
# Every `set_*` below is the assigning form; the printing form is kept beside it
# where it still has non-hot callers. Behaviour is identical either way.
HUSK_HAVE_CYGPATH=0
command -v cygpath >/dev/null 2>&1 && HUSK_HAVE_CYGPATH=1
HUSK_RCD=""        # repo_common_dir
HUSK_REPO_ID=""    # repo_id
HUSK_SB=""         # store_base, guarded by the HUSK_STORE it was built from
HUSK_SB_FOR=""
HUSK_RR=""         # repo_root, guarded by the cwd it was resolved from
HUSK_RR_PWD=""
HUSK_OS_TAG=""
HUSK_ARCH=""
HUSK_SHA_CMD=""    # resolved hasher: shasum -a 256 or sha256sum
HUSK_DRIVE_SHORTCUT=-1   # -1 untested, 1 shell C:/ -> /c/ agrees with cygpath, 0 it does not
HUSK_MAIN=""       # main_worktree
HUSK_EXCLUDED=0    # exclude_husk_dir already ran
HUSK_CONF_FOR=""   # root that load_conf was last run for
# scratch outputs of the set_* helpers. Callers must copy to a local before the
# next set_* of the same name; none of these survive a nested call.
HUSK_PP=""; HUSK_ABS=""; HUSK_DIRN=""; HUSK_BASE=""
HUSK_SF=""; HUSK_ENTRY=""; HUSK_KEY=""; HUSK_FP=""; HUSK_PROBE=""; HUSK_CANDS=""
HUSK_REC=""
HUSK_DEPDIRS=""
HUSK_NL='
'                  # a literal newline, for first-line-of trimming without `head`
HUSK_TAB='	'      # a literal tab, for splitting state rows without a subshell

dir_of() {  # path -> $HUSK_DIRN. `dirname` without a process.
  # Trailing-slash inputs are not handled the way dirname handles them; husk
  # never builds one, and the two spots that could (user-supplied add paths)
  # go through git or abspath first.
  case "$1" in
    */*) HUSK_DIRN=${1%/*}; [ -n "$HUSK_DIRN" ] || HUSK_DIRN=/ ;;
    *)   HUSK_DIRN=. ;;
  esac
}

base_of() { HUSK_BASE=${1##*/}; }   # path -> $HUSK_BASE. `basename` without a process.

HUSK_NOW=0
now_ts() { # -> $HUSK_NOW, seconds since epoch
  # Assigns rather than prints on purpose: `n=$(now_ts)` forks a subshell even
  # when the value comes from a builtin, and the fork is the whole cost being
  # cut here. bash 3.2 (stock macOS) has no EPOCHSECONDS and still pays `date`.
  if [ -n "${EPOCHSECONDS:-}" ]; then HUSK_NOW=$EPOCHSECONDS
  else HUSK_NOW=$(date +%s); fi
}

# ---------- output conventions ----------
# stdout: stable key=value lines (machine-readable)
# stderr: human prose
note() { printf 'husk: %s\n' "$*" >&2; }
die()  { printf 'husk: error: %s\n' "$*" >&2; exit 1; }
out()  { printf '%s\n' "$*"; }

# ---------- portability helpers ----------
sha256() { # stdin -> hash
  # The `| cut` is gone on purpose: parameter expansion trims the "  -" suffix
  # for free, where cut costs a process per hash. Same reason the hasher choice
  # is resolved once instead of on every call.
  [ -n "$HUSK_SHA_CMD" ] || {
    if command -v shasum >/dev/null 2>&1; then HUSK_SHA_CMD="shasum -a 256"
    else HUSK_SHA_CMD="sha256sum"; fi
  }
  local o; o=$($HUSK_SHA_CMD)
  printf '%s' "${o%% *}"
}

mtime_of() { # file -> epoch seconds
  if stat -f %m "$1" >/dev/null 2>&1; then stat -f %m "$1"
  else stat -c %Y "$1"; fi
}

batch_hash() { # stdin: NUL-separated paths -> "HASH  path" lines
  # openssl and sha256sum are C implementations; shasum is perl (~8x slower)
  if openssl sha256 -r /dev/null >/dev/null 2>&1; then xargs -0 openssl sha256 -r 2>/dev/null
  elif command -v sha256sum >/dev/null 2>&1; then xargs -0 sha256sum 2>/dev/null
  else xargs -0 shasum -a 256 2>/dev/null; fi
}

batch_perms() { # tree -> "PERMS path" lines (batched stat, few forks)
  if stat -f %Lp "$1" >/dev/null 2>&1; then
    find "$1" -type f -exec stat -f '%Lp %N' {} + 2>/dev/null
  else
    find "$1" -type f -exec stat -c '%a %n' {} + 2>/dev/null
  fi
}

set_abspath() { # dir -> $HUSK_ABS (empty if the dir does not exist)
  local p
  p=$(cd "$1" 2>/dev/null && pwd -P) || { HUSK_ABS=""; return 0; }
  set_posix_path "$p"; HUSK_ABS=$HUSK_PP
}
abspath() { set_abspath "$1"; printf '%s' "$HUSK_ABS"; }

set_posix_path() { # path -> $HUSK_PP
  # git.exe on Windows emits C:/-style paths, and MSYS mounts spell one dir two
  # ways (/tmp vs /c/Users/.../Temp); hashing or comparing mixed spellings
  # silently splits the store namespace. Canonical form is cygpath -u of the
  # Windows form, so every absolute path collapses to one spelling.
  if [ "$HUSK_HAVE_CYGPATH" != 1 ]; then HUSK_PP=$1; return 0; fi
  # Memoized: the /* branch costs TWO cygpath processes, and callers ask about
  # the same handful of paths repeatedly. The cache stores the key beside the
  # value and compares it, so two paths whose sanitized names collide take a
  # miss instead of silently receiving each other's answer.
  local k ck
  k="HUSK_PPC_${1//[^a-zA-Z0-9]/_}"
  eval "ck=\${${k}_K-}"
  if [ "$ck" = "$1" ]; then eval "HUSK_PP=\${${k}_V}"; return 0; fi
  case "$1" in
    [A-Za-z]:*) drive_to_posix "$1" ;;
    /*)         HUSK_PP=$(cygpath -m "$1"); drive_to_posix "$HUSK_PP" ;;
    *)          HUSK_PP=$1; return 0 ;;
  esac
  eval "${k}_K=\$1; ${k}_V=\$HUSK_PP"
}
posix_path() { set_posix_path "$1"; printf '%s' "$HUSK_PP"; }

drive_to_posix() { # C:/foo or C:\foo -> /c/foo, in the shell, setting $HUSK_PP
  # `cygpath -u` costs a process (~1.5s here) for what is a two-character
  # rewrite under the default MSYS mount table. Rather than assume the table is
  # default, the first conversion of the process is checked against cygpath; if
  # they disagree -- a custom /etc/fstab, a UNC path, a substed drive -- the
  # shell shortcut is switched off for good and every path goes back through
  # cygpath. One exec to buy certainty, then none.
  local d=${1%%:*} r=${1#*:} i up=ABCDEFGHIJKLMNOPQRSTUVWXYZ lo=abcdefghijklmnopqrstuvwxyz cg
  r=${r//\\//}
  case "$d" in
    [a-z]) ;;
    [A-Z]) i=${up%%"$d"*}; d=${lo:${#i}:1} ;;
    *)     HUSK_PP=$(cygpath -u "$1"); return 0 ;;   # not a plain drive letter
  esac
  case "$r" in /*) ;; *) HUSK_PP=$(cygpath -u "$1"); return 0 ;; esac  # C:rel, not absolute
  if [ "$HUSK_DRIVE_SHORTCUT" = 0 ]; then HUSK_PP=$(cygpath -u "$1"); return 0; fi
  HUSK_PP="/$d$r"
  if [ "$HUSK_DRIVE_SHORTCUT" = -1 ]; then
    cg=$(cygpath -u "$1")
    if [ "$cg" = "$HUSK_PP" ]; then HUSK_DRIVE_SHORTCUT=1
    else HUSK_DRIVE_SHORTCUT=0; HUSK_PP=$cg; fi
  fi
}

posix_path_stream() { # stdin: one path per line -> POSIX view (no-op off Windows)
  if [ "$HUSK_HAVE_CYGPATH" = 1 ]; then cygpath -u -f -; else cat; fi
}

# ---------- repo context ----------
set_repo_root() { # -> $HUSK_RR
  # Guarded by cwd: a linked worktree and its main checkout have DIFFERENT roots,
  # so this may only be reused while the process stays in the same directory.
  if [ -n "$HUSK_RR" ] && [ "$HUSK_RR_PWD" = "$PWD" ]; then return 0; fi
  local r; r=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
  set_posix_path "$r"; HUSK_RR=$HUSK_PP; HUSK_RR_PWD=$PWD
}
repo_root() { set_repo_root; printf '%s' "$HUSK_RR"; }

set_repo_common_dir() { # -> $HUSK_RCD
  # Unguarded on purpose: --git-common-dir is the SAME directory whether you ask
  # from the main checkout or any of its linked worktrees. That invariance is
  # exactly what makes one store namespace serve a repo and all its worktrees,
  # so a single resolution is valid for the whole process.
  [ -z "$HUSK_RCD" ] || return 0
  local c=""
  # Derive it from the checkout before paying `git rev-parse` a process. The
  # layout is fixed: a main checkout has .git as a directory, a linked worktree
  # has .git as a file reading "gitdir: <common>/worktrees/<name>". Anything the
  # derivation cannot confirm -- an env override, a relative gitdir, a bare or
  # unusual repo -- falls through to git, which is always authoritative.
  if [ -z "${GIT_DIR:-}" ] && [ -z "${GIT_COMMON_DIR:-}" ]; then
    set_repo_root
    if [ -d "$HUSK_RR/.git" ]; then
      c="$HUSK_RR/.git"
    elif [ -f "$HUSK_RR/.git" ]; then
      local gd; read -r _ gd < "$HUSK_RR/.git" 2>/dev/null || gd=""
      case "$gd" in
        /*|[A-Za-z]:*) case "$gd" in */worktrees/*) c="${gd%/worktrees/*}" ;; esac ;;
      esac
    fi
    # confirm the guess actually IS a git dir before trusting it
    [ -n "$c" ] && [ -f "$c/config" ] || c=""
  fi
  [ -n "$c" ] || c=$(git rev-parse --git-common-dir)
  set_posix_path "$c"; c=$HUSK_PP
  case "$c" in /*) ;; *) c="$PWD/$c" ;; esac
  set_abspath "$c"; HUSK_RCD=$HUSK_ABS
}
repo_common_dir() { set_repo_common_dir; printf '%s' "$HUSK_RCD"; }

set_repo_id() { # -> $HUSK_REPO_ID
  [ -z "$HUSK_REPO_ID" ] || return 0
  set_repo_common_dir
  # Cached in the git common dir, because hashing costs a pipeline (~5s here)
  # and the answer is a pure function of a path that cannot change while the
  # cache file sits inside it. The path is stored beside the id and compared:
  # move the repo and the id must change, so a stale line is ignored, not used.
  local cf="$HUSK_RCD/husk-repo-id" cid cpath h
  if [ -f "$cf" ]; then
    IFS=$HUSK_TAB read -r cid cpath < "$cf" 2>/dev/null || true
    if [ -n "$cid" ] && [ "$cpath" = "$HUSK_RCD" ]; then HUSK_REPO_ID=$cid; return 0; fi
  fi
  h=$(printf '%s' "$HUSK_RCD" | sha256)
  HUSK_REPO_ID=${h:0:12}
  printf '%s\t%s\n' "$HUSK_REPO_ID" "$HUSK_RCD" > "$cf" 2>/dev/null || true
}
repo_id() { set_repo_id; printf '%s' "$HUSK_REPO_ID"; }

set_main_worktree() { # -> $HUSK_MAIN
  # `git worktree list` always prints the main checkout first, and that answer
  # cannot change while one husk process runs -- `husk add` creates a LINKED
  # worktree, never a new main. Was four processes (git|head|sed|cygpath) per
  # call; now one, once.
  [ -z "$HUSK_MAIN" ] || return 0
  local o; o=$(git worktree list --porcelain)
  o=${o%%"$HUSK_NL"*}
  set_posix_path "${o#worktree }"; HUSK_MAIN=$HUSK_PP
}
main_worktree() { set_main_worktree; printf '%s' "$HUSK_MAIN"; }

exclude_husk_dir() { # keep .husk/ out of git status without touching the repo
  # Idempotent, so the second and later callers in one process are a no-op.
  # info/exclude lives in the COMMON dir (it is shared by every worktree), which
  # husk already knows, so this costs no processes at all: no `git rev-parse
  # --git-path`, and the membership test is a read loop rather than a grep.
  if [ "$HUSK_EXCLUDED" = 1 ]; then return 0; fi
  set_repo_common_dir
  local ex="$HUSK_RCD/info/exclude" line
  [ -n "$HUSK_RCD" ] || return 0
  if [ -f "$ex" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      if [ "$line" = ".husk/" ]; then HUSK_EXCLUDED=1; return 0; fi
    done < "$ex"
  else
    mkdir -p "$HUSK_RCD/info" 2>/dev/null || return 0
  fi
  printf '.husk/\n' >> "$ex" 2>/dev/null || true
  HUSK_EXCLUDED=1
}

# ---------- config ----------
load_conf() { # .husk.conf at repo root: KEY=VALUE lines, parsed - NEVER sourced.
  # Agents run husk inside freshly cloned repos (AGENTS.md tells them to);
  # sourcing would hand any repository arbitrary code execution on 'husk add'.
  # Idempotent for a given root, and every command calls it at least once while
  # cmd_add calls it twice. Re-running it re-parses the file and re-pays
  # store_guard's three processes for a result that cannot have changed.
  if [ "$HUSK_CONF_FOR" = "$1" ]; then return 0; fi
  local root="$1" f="$1/.husk.conf" line k v
  if [ -f "$f" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in \#*|"") continue ;; esac
      line=${line#export }                    # tolerate old shell-style files
      k=${line%%=*}; v=${line#*=}
      k=${k// /}; k=${k//"$HUSK_TAB"/}         # was: printf | tr -d, two processes per line
      case "$v" in \"*\") v=${v%\"}; v=${v#\"} ;; \'*\') v=${v%\'}; v=${v#\'} ;; esac
      # shellcheck disable=SC2088  # matching a LITERAL ~/ in the conf value is the point
      case "$v" in "~/"*) v="$HOME/${v#"~/"}" ;; '$HOME/'*) v="$HOME/${v#'$HOME/'}" ;; esac
      case "$k" in
        HUSK_STORE) HUSK_STORE=$v ;;
        HUSK_DIRS)  HUSK_DIRS=$v ;;
        HUSK_MODE)
          case "$v" in
            auto|clone|hardlink|symlink|copy) HUSK_MODE=$v ;;
            *) note ".husk.conf: invalid HUSK_MODE '$v' ignored" ;;
          esac ;;
        HUSK_COMPRESS)
          case "$v" in
            auto|0|1) HUSK_COMPRESS=$v ;;
            *) note ".husk.conf: invalid HUSK_COMPRESS '$v' ignored (auto|0|1)" ;;
          esac ;;
        HUSK_REAP_DAYS|HUSK_DEDUPE|HUSK_NUDGE_SECS|HUSK_LOCK_TIMEOUT|HUSK_LOCK_TIMEOUT_BUSY)
          case "$v" in
            ''|*[!0-9]*) note ".husk.conf: non-numeric $k '$v' ignored" ;;
            *) eval "$k=\$v" ;;   # k is one of the literal names above, v is digits
          esac ;;
        *) note ".husk.conf: ignoring unknown key: ${k:-<empty>}" ;;
      esac
    done < "$f"
  fi
  store_guard "$root"
  HUSK_CONF_FOR="$1"
}

store_guard() { # root -> refuse a store inside the repo: 'git worktree remove',
  # 'husk reap' or a plain rm -rf of the checkout would destroy every entry
  local root="$1" sb d
  sb="$HUSK_STORE"
  case "$sb" in /*) ;; *) sb="$(pwd)/$sb" ;; esac
  # resolve through the nearest existing ancestor: the store may not exist yet,
  # and /var -> /private/var style symlinks would otherwise dodge the comparison
  d="$sb"
  while [ ! -d "$d" ] && [ "$d" != "/" ] && [ "$d" != "." ]; do dir_of "$d"; d=$HUSK_DIRN; done
  sb="$(cd "$d" && pwd -P)${sb#"$d"}"
  root=$(cd "$root" 2>/dev/null && pwd -P) || return 0
  case "$sb" in
    "$root"|"$root"/*) die "HUSK_STORE ($sb) is inside the repo ($root); deleting a worktree would destroy the store. Set HUSK_STORE to a path outside the repo." ;;
  esac
}

# ---------- lockfile mapping ----------
# These set a variable rather than echo, because `for f in $(candidates "$d")`
# forked a subshell for what is a pure case statement.
set_lockfile_candidates() { # dep dir name -> $HUSK_CANDS, ordered lockfile candidates
  case "$1" in
    node_modules) HUSK_CANDS="package-lock.json npm-shrinkwrap.json pnpm-lock.yaml yarn.lock bun.lockb bun.lock" ;;
    .venv|venv)   HUSK_CANDS="uv.lock poetry.lock Pipfile.lock requirements.txt" ;;
    target)       HUSK_CANDS="Cargo.lock" ;;
    vendor)       HUSK_CANDS="Gemfile.lock composer.lock go.sum" ;;
    Pods)         HUSK_CANDS="Podfile.lock" ;;
    *)            HUSK_CANDS="" ;;
  esac
}

set_manifest_candidates() { # fallback when no lockfile exists
  case "$1" in
    node_modules) HUSK_CANDS="package.json" ;;
    .venv|venv)   HUSK_CANDS="pyproject.toml setup.py" ;;
    target)       HUSK_CANDS="Cargo.toml" ;;
    vendor)       HUSK_CANDS="Gemfile composer.json go.mod" ;;
    Pods)         HUSK_CANDS="Podfile" ;;
    *)            HUSK_CANDS="" ;;
  esac
}

set_fingerprint_file() { # root dir -> $HUSK_FP, first existing lockfile (or manifest), empty if none
  local root="$1" f
  set_lockfile_candidates "$2"
  for f in $HUSK_CANDS; do
    if [ -f "$root/$f" ]; then HUSK_FP="$root/$f"; return 0; fi
  done
  set_manifest_candidates "$2"
  for f in $HUSK_CANDS; do
    if [ -f "$root/$f" ]; then HUSK_FP="$root/$f"; return 0; fi
  done
  HUSK_FP=""
}
find_fingerprint_file() { set_fingerprint_file "$1" "$2"; printf '%s' "$HUSK_FP"; }

set_os_tag() { # stable OS identity for store keys. MSYS bakes the Windows build
  # into 'uname -s' (MINGW64_NT-10.0-26200): left raw, every Windows update
  # would silently re-key the whole store and force a full reseed.
  [ -z "$HUSK_OS_TAG" ] || return 0
  local s; s=$(uname -s)
  case "$s" in MINGW*_NT*|MSYS_NT*|CYGWIN_NT*) s="${s%%-*}" ;; esac
  HUSK_OS_TAG=$s
}

set_arch_tag() { # machine arch, resolved once per process
  [ -z "$HUSK_ARCH" ] || return 0
  HUSK_ARCH=$(uname -m)
}

set_key_for() { # root dir -> $HUSK_KEY, content key (empty if unfingerprintable)
  local fp h
  # cleared up front: callers that tolerate failure (`set_key_for ... || true`)
  # would otherwise read the PREVIOUS dir's key out of the global and compare it
  # against this dir's recorded one.
  HUSK_KEY=""
  set_fingerprint_file "$1" "$2"; fp=$HUSK_FP
  [ -n "$fp" ] || { HUSK_KEY=""; return 0; }
  set_os_tag; set_arch_tag
  # Line endings are stripped out of the key, because git puts them back
  # differently in different checkouts. With core.autocrlf=true -- the Git for
  # Windows default -- a lockfile committed with LF arrives in a fresh worktree
  # as CRLF, so the same dependency tree fingerprints differently in the main
  # checkout and in every worktree made from it, and husk misses its own store
  # on every single `husk add`. Nothing breaks loudly; sharing just silently
  # never happens, which is the worst failure this tool has.
  #
  # Safe because a lockfile's meaning does not depend on its line endings: two
  # files that differ only there describe the same tree, so sharing between
  # them is correct. bun.lockb is the one binary candidate and is hashed raw,
  # where a stray 0x0d is data, not a line ending.
  #
  # This costs no extra process: `tr` replaces the `cat` that was already here.
  base_of "$fp"
  case "$HUSK_BASE" in
    *.lockb) h=$({ printf '%s\n%s-%s\n' "$2" "$HUSK_OS_TAG" "$HUSK_ARCH"; cat "$fp"; } | sha256) ;;
    *)       h=$({ printf '%s\n%s-%s\n' "$2" "$HUSK_OS_TAG" "$HUSK_ARCH"; tr -d '\r' < "$fp"; } | sha256) ;;
  esac
  HUSK_KEY=${h:0:16}
}
key_for() { set_key_for "$1" "$2"; printf '%s' "$HUSK_KEY"; }

set_detect_dirs() { # root -> $HUSK_DEPDIRS, dep dirs relevant to this repo
  local root="$1" d found=""
  if [ -n "${HUSK_DIRS:-}" ]; then HUSK_DEPDIRS=$HUSK_DIRS; return 0; fi
  for d in $KNOWN_DIRS; do
    # claim the dir if it exists, or a lockfile/manifest maps to it
    set_fingerprint_file "$root" "$d"
    if [ -e "$root/$d" ] || [ -n "$HUSK_FP" ]; then
      found="$found $d"
    fi
  done
  HUSK_DEPDIRS=$found
}
detect_dirs() { set_detect_dirs "$1"; printf '%s' "$HUSK_DEPDIRS"; }

# ---------- store ----------
set_store_base() { # -> $HUSK_SB
  # Guarded by HUSK_STORE: load_conf can change it after the first call, and the
  # tests set it per case. The guard makes the cache follow the variable instead
  # of freezing whichever store happened to be first.
  if [ -n "$HUSK_SB" ] && [ "$HUSK_SB_FOR" = "$HUSK_STORE" ]; then return 0; fi
  set_repo_id
  HUSK_SB="$HUSK_STORE/$HUSK_REPO_ID"; HUSK_SB_FOR="$HUSK_STORE"
}
store_base() { set_store_base; printf '%s' "$HUSK_SB"; }

set_entry_path() { set_store_base; HUSK_ENTRY="$HUSK_SB/$1/$2"; }   # dir key -> $HUSK_ENTRY
entry_path() { set_entry_path "$1" "$2"; printf '%s' "$HUSK_ENTRY"; }

# ---------- locking (portable: no flock on macOS) ----------
steal_lock() { # lockdir expected-dead-pid -> 0 stolen, 1 lost the race
  # rename first (atomic, exactly one stealer wins), then verify the captured
  # dir still holds the pid we judged dead. A plain rm -rf here would let a
  # slow second stealer wipe the lock a THIRD process just legitimately
  # acquired; with rename+verify the mistake is detectable and undone.
  local lock="$1" dead="$2" got age
  mv "$lock" "$lock.stale.$$" 2>/dev/null || return 1
  got=$(cat "$lock.stale.$$/pid" 2>/dev/null || echo "")
  if [ -n "$got" ] && [ "$got" != "$dead" ] && kill -0 "$got" 2>/dev/null; then
    # captured a LIVE holder's fresh lock by mistake: give it back
    mv "$lock.stale.$$" "$lock" 2>/dev/null || rm -rf "$lock.stale.$$"
    return 1
  fi
  if [ -z "$got" ]; then
    # pid-less capture: either the orphan we judged dead, or a FRESH lock
    # caught between its mkdir and its pid write. Only age tells them apart
    # (rename does not touch the dir's own mtime, so it survives the mv):
    # young means fresh acquisition, give it back.
    age=$(( $(date +%s) - $(mtime_of "$lock.stale.$$" 2>/dev/null || echo 0) ))
    if [ "$age" -le 30 ]; then
      mv "$lock.stale.$$" "$lock" 2>/dev/null || rm -rf "$lock.stale.$$"
      return 1
    fi
  fi
  rm -rf "$lock.stale.$$"
  return 0
}

acquire_lock() { # lockdir
  local lock="$1" waited=0 pid age
  while :; do
    if mkdir "$lock" 2>/dev/null; then
      # publish ownership, then confirm the lock survived the publish window:
      # a stealer that captured the dir before our pid landed leaves us
      # lockless (the pid write lands nowhere), so re-enter the wait loop
      # instead of proceeding unlocked.
      echo $$ > "$lock/pid" 2>/dev/null || true
      if [ "$(cat "$lock/pid" 2>/dev/null)" = "$$" ]; then
        HUSK_CLEAN_LOCK="$lock"
        return 0
      fi
      continue
    fi
    pid=$(cat "$lock/pid" 2>/dev/null || echo "")
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      note "stealing stale lock (dead pid $pid): $lock"
      steal_lock "$lock" "$pid" || true
      continue
    fi
    if [ -z "$pid" ]; then
      # holder died between mkdir and writing its pid; steal once it's old
      now_ts
      age=$(( HUSK_NOW - $(mtime_of "$lock" 2>/dev/null || printf '%s' "$HUSK_NOW") ))
      if [ "$age" -gt 30 ]; then
        note "stealing pid-less lock (${age}s old): $lock"
        steal_lock "$lock" "" || true
        continue
      fi
    fi
    if [ -n "$pid" ]; then
      # live holder: it may legitimately be slow (an installer runs under the
      # seed lock), so give it the long budget, not the 2-minute one
      [ "$waited" -ge "${HUSK_LOCK_TIMEOUT_BUSY:-3600}" ] \
        && die "timed out waiting for lock (live holder pid $pid): $lock"
    else
      [ "$waited" -ge "$HUSK_LOCK_TIMEOUT" ] && die "timed out waiting for lock: $lock"
    fi
    sleep 1; waited=$((waited + 1))
  done
}
release_lock() { rm -rf "$1"; HUSK_CLEAN_LOCK=""; }

# interruption safety: Ctrl-C, kill, or hangup mid-seed must not strand a held
# lock (siblings would stall until timeout/steal) or a half-built tmp dir.
# Tracked globals are set while owned, cleared on clean handoff; the EXIT
# trap sweeps whatever is still marked. rm_rf_safe is defined just below.
HUSK_CLEAN_LOCK=""
HUSK_CLEAN_TMP=""
HUSK_PREFARM_TMP=""
HUSK_PREFARM_PID=""
HUSK_WINFARM_PS=""
HUSK_CLEAN_PS=""
PROBE_CACHE_KEY=""
PROBE_CACHE_VAL=""
husk_cleanup() {
  [ -n "$HUSK_CLEAN_TMP" ] && rm_rf_safe "$HUSK_CLEAN_TMP" 2>/dev/null
  [ -n "$HUSK_CLEAN_LOCK" ] && rm -rf "$HUSK_CLEAN_LOCK" 2>/dev/null
  [ -n "$HUSK_CLEAN_PS" ] && rm -f "$HUSK_CLEAN_PS" 2>/dev/null
  if [ -n "$HUSK_PREFARM_TMP" ]; then
    [ -n "$HUSK_PREFARM_PID" ] && kill "$HUSK_PREFARM_PID" 2>/dev/null
    wait 2>/dev/null || true
    rm_rf_safe "$HUSK_PREFARM_TMP" 2>/dev/null
    rm -f "$HUSK_PREFARM_TMP.done" "$HUSK_PREFARM_TMP.failed" 2>/dev/null
  fi
  return 0
}
trap husk_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# ---------- copy engines ----------
rm_rf_safe() { # dir -> remove even when copies inherited a read-only root (mode 555):
  # a non-root rm -rf cannot unlink children of an unwritable dir, so unguard first
  [ -e "$1" ] || return 0
  chmod -R u+w "$1" 2>/dev/null || true
  rm -rf "$1"
}

par_fanout() { # src dst clone|copy -> parallel per-top-level-entry copy across cores
  local src="$1" dst="$2" op="$3" j
  j=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
  [ "$j" -gt 8 ] && j=8
  case "$dst" in /*) ;; *) dst="$(pwd)/$dst" ;; esac
  mkdir "$dst" 2>/dev/null || return 1
  if [ "$op" = clone ]; then
    ( cd "$src" && find . -mindepth 1 -maxdepth 1 -print0 \
      | xargs -0 -P "$j" -n 20 sh -c 'exec cp -c -R "$@" "$0/"' "$dst" ) 2>/dev/null && return 0
  else
    ( cd "$src" && find . -mindepth 1 -maxdepth 1 -print0 \
      | xargs -0 -P "$j" -n 20 sh -c 'exec cp -Rp "$@" "$0/"' "$dst" ) 2>/dev/null && return 0
  fi
  rm_rf_safe "$dst"; return 1
}

cow_clone() { # src dst -> 0 if CoW clone succeeded; never leaves a partial dst
  if [ -d "$1" ] && par_fanout "$1" "$2" clone; then return 0; fi     # macOS APFS, fanned out
  if cp -c -R "$1" "$2" 2>/dev/null; then return 0; fi                # macOS serial (files, edge cases)
  rm_rf_safe "$2"
  if cp -R --reflink=always "$1" "$2" 2>/dev/null; then return 0; fi  # btrfs/xfs
  rm_rf_safe "$2"           # GNU cp fails per-file AFTER creating dirs (with source
  return 1                  # modes, possibly read-only); residue would jam every fallback
}

win_farm() { # src dst -> 0 on success, 1 to fall through to the portable chain
  # MSYS `cp -al` pays POSIX emulation and path translation on every one of a
  # node_modules' ~21,000 files. A native CreateHardLinkW walk pays neither:
  # measured 17.8s against cp -al's 25.3s and perl's 22.6s on the same tree,
  # all three producing identical trees with shared inodes.
  #
  # Strictly first-choice-with-fallback: any failure here (no powershell, no
  # C# compiler, a reparse point, one failed link) returns 1 and hardlink_farm
  # continues down the chain it always used, so this Windows-only branch can
  # rot without ever becoming a correctness risk.
  [ "$HUSK_HAVE_CYGPATH" = 1 ] || return 1
  [ "${HUSK_WINFARM:-1}" = "1" ] || return 1
  command -v powershell >/dev/null 2>&1 || return 1

  # Size gate, paid for with a glob instead of a walk. PowerShell startup plus
  # the Add-Type compile costs a couple of seconds flat, which LOSES to cp -al
  # on a small tree -- but counting the tree to find out would cost more than
  # the decision saves. Top-level children stand in for size: a real
  # node_modules has hundreds of package directories, a fixture has three.
  local min="${HUSK_WINFARM_MIN:-64}" n=0 f
  for f in "$1"/*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    n=$((n+1))
    [ "$n" -ge "$min" ] && break
  done
  [ "$n" -ge "$min" ] || return 1

  # Written fresh and deleted at the end of this call, rather than kept for the
  # life of the process. The prefarm runs hardlink_farm inside a background
  # subshell, where the EXIT trap does not fire and an assignment to a cleanup
  # global never reaches the parent that would sweep it, so a memoized script
  # leaked one file per `husk add`. BASHPID, not $$, for the same reason: in
  # that subshell $$ is still the parent's pid, and two concurrent farms would
  # write and delete one path.
  HUSK_WINFARM_PS="${TMPDIR:-/tmp}/husk-winfarm.${BASHPID:-$$}.ps1"
  HUSK_CLEAN_PS="$HUSK_WINFARM_PS"
  cat > "$HUSK_WINFARM_PS" <<'HUSK_WINFARM_EOF'
param([Parameter(Mandatory=$true)][string]$Src,
      [Parameter(Mandatory=$true)][string]$Dst)
$ErrorActionPreference = 'Stop'
Add-Type -TypeDefinition @'
using System;
using System.IO;
using System.Runtime.InteropServices;

public static class HuskFarm {
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    [return: MarshalAs(UnmanagedType.Bool)]
    static extern bool CreateHardLinkW(string lpFileName, string lpExistingFileName, IntPtr lpSecurityAttributes);

    public static int Errors = 0;
    public static int Files = 0;

    // node_modules nests past MAX_PATH; the \\?\ prefix is the only form
    // CreateHardLinkW accepts for those.
    static string Ext(string p) {
        if (p.StartsWith(@"\\?\")) return p;
        if (p.StartsWith(@"\\")) return @"\\?\UNC\" + p.Substring(2);
        return @"\\?\" + p;
    }

    public static void Farm(string src, string dst) {
        src = Path.GetFullPath(src);
        dst = Path.GetFullPath(dst);
        Directory.CreateDirectory(Ext(dst));
        Walk(src, dst);
    }

    static void Walk(string src, string dst) {
        foreach (string d in Directory.EnumerateDirectories(Ext(src))) {
            string name = Path.GetFileName(d);
            // A junction or symlink is not a directory to descend into, and
            // this walker cannot reproduce one. Hand the tree back instead.
            FileAttributes a = File.GetAttributes(Ext(d));
            if ((a & FileAttributes.ReparsePoint) != 0) { Errors++; return; }
            string target = Path.Combine(dst, name);
            Directory.CreateDirectory(Ext(target));
            Walk(Path.Combine(src, name), target);
            if (Errors > 0) return;
        }
        foreach (string f in Directory.EnumerateFiles(Ext(src))) {
            string name = Path.GetFileName(f);
            if (!CreateHardLinkW(Ext(Path.Combine(dst, name)), Ext(Path.Combine(src, name)), IntPtr.Zero)) {
                Errors++;
                return;   // bail on first failure; the caller discards the partial tree
            }
            Files++;
        }
    }
}
'@
try { [HuskFarm]::Farm($Src, $Dst) } catch { exit 1 }
if ([HuskFarm]::Errors -gt 0) { exit 1 }
exit 0
HUSK_WINFARM_EOF

  local wsrc wdst wps rc=1
  if wsrc=$(cygpath -w "$1") && wdst=$(cygpath -w "$2") && wps=$(cygpath -w "$HUSK_WINFARM_PS"); then
    powershell -NoProfile -ExecutionPolicy Bypass -File "$wps" -Src "$wsrc" -Dst "$wdst" >/dev/null 2>&1 && rc=0
  fi
  rm -f "$HUSK_WINFARM_PS" 2>/dev/null
  HUSK_WINFARM_PS=""; HUSK_CLEAN_PS=""
  [ "$rc" = 0 ] && return 0
  rm_rf_safe "$2"
  return 1
}

hardlink_farm() { # src dst -> 0 on success; never leaves a partial dst
  if win_farm "$1" "$2"; then return 0; fi                      # native Win32
  if cp -al "$1" "$2" 2>/dev/null; then return 0; fi            # GNU cp
  rm_rf_safe "$2"
  if command -v perl >/dev/null 2>&1; then
    # one process, one link(2) per file (BSD pax forks its way to ~10x slower)
    if perl -MFile::Find -e '
      my ($src, $dst) = @ARGV;
      my $err = 0;
      mkdir $dst or exit 1;
      find({ no_chdir => 1, wanted => sub {
        my $n = $File::Find::name;
        my $rel = substr($n, length($src));
        return unless length $rel;
        my $t = "$dst$rel";
        lstat $n;
        if    (-l _) { symlink(readlink($n), $t) or $err++ }
        elsif (-d _) { mkdir($t) or $err++; chmod((stat($n))[2] & 07777, $t) }
        else         { link($n, $t) or $err++ }
      }}, $src);
      exit($err ? 1 : 0);
    ' "$1" "$2" 2>/dev/null; then return 0; fi
    rm_rf_safe "$2"
  fi
  if command -v pax >/dev/null 2>&1; then
    mkdir -p "$2" && (cd "$1" && pax -rwl . "$(cd "$2" && pwd)") 2>/dev/null && return 0
    rm_rf_safe "$2"
  fi
  return 1
}

make_junction() { # link entry -> 0 if a real directory junction now exists at $1
  # Windows has three ways to point one directory at another and only one of
  # them works unprivileged: a junction. MSYS `ln -s` without Developer Mode
  # silently makes a COPY, which is why forced symlink mode used to degrade all
  # the way to copy here and quietly stop sharing anything.
  #
  # Verified against every deletion path husk uses (rm -rf, mv + rm -rf, git
  # worktree remove, and rm_rf_safe's chmod -R u+w + rm -rf): each removes the
  # link and leaves the store target intact. MSYS also reports a junction as -L
  # with a working readlink, so every check downstream that already handled a
  # symlink handles this one unchanged.
  [ "$HUSK_HAVE_CYGPATH" = 1 ] || return 1
  [ "${HUSK_JUNCTION:-1}" = "1" ] || return 1
  command -v cmd >/dev/null 2>&1 || return 1
  local wl we
  wl=$(cygpath -w "$1") || return 1
  we=$(cygpath -w "$2") || return 1
  cmd //c mklink //J "$wl" "$we" >/dev/null 2>&1 || return 1
  # trust nothing: a junction that did not actually resolve is worse than none
  [ -L "$1" ] && [ -d "$1" ]
}

plain_copy() { # src dst -> dst must not pre-exist (partial dst is removed, see cow_clone)
  if [ -d "$1" ] && par_fanout "$1" "$2" copy; then return 0; fi
  rm_rf_safe "$2"
  cp -Rp "$1" "$2" || { rm_rf_safe "$2"; return 1; }
  chmod u+w "$2" 2>/dev/null || true   # source root may be write-guarded; a copy is private
}

set_probe_mode() { # storefs wtfs -> $HUSK_PROBE, the best mode between them
  local storefs="$1" wtfs="$2"
  # pid-unique names: a shared probe file lets two concurrent probes delete
  # each other's file mid-ladder and silently downgrade both to copy mode
  local probe="$storefs/.husk-probe.$$" t="$wtfs/.husk-probe.$$"
  if [ "$HUSK_MODE" != "auto" ]; then HUSK_PROBE=$HUSK_MODE; return 0; fi

  # Disk cache. Walking the ladder costs three exec'd copy attempts (~12s on
  # Windows) to re-derive a fact about two filesystems that does not change
  # between runs. Keyed on the store plus the worktree's PARENT, because the
  # worktree itself is new on every `husk add` while its parent is where the
  # whole fleet lives.
  #
  # Only a SHARING answer is ever written. That asymmetry is the safety
  # property: a stale entry can only claim MORE sharing than the filesystems
  # now support, and provision() already catches that and falls back to copy,
  # loudly. A stale "copy" would silently stop sharing forever, so "copy" is
  # never cached and gets re-probed every time.
  local ck cf cmode ckey
  dir_of "$wtfs"; ck="$storefs|$HUSK_DIRN"
  if [ "${HUSK_PROBE_CACHE:-1}" = "1" ]; then
    set_repo_common_dir; cf="$HUSK_RCD/husk-probe-cache"
    if [ -f "$cf" ]; then
      while IFS=$HUSK_TAB read -r cmode ckey; do
        if [ "$ckey" = "$ck" ]; then HUSK_PROBE=$cmode; return 0; fi
      done < "$cf"
    fi
  else
    cf=""
  fi

  mkdir -p "$storefs" "$wtfs"
  echo probe > "$probe"
  if cow_clone "$probe" "$t"; then rm -f "$t" "$probe"; HUSK_PROBE=clone; probe_cache_put "$cf" "$ck"; return 0; fi
  if ln "$probe" "$t" 2>/dev/null; then rm -f "$t" "$probe"; HUSK_PROBE=hardlink; probe_cache_put "$cf" "$ck"; return 0; fi
  # verify symlinks are REAL here: MSYS/Git Bash "ln -s" silently copies unless
  # symlink privilege is enabled, which would fake sharing while eating full disk
  if ln -s "$probe" "$t" 2>/dev/null && [ -L "$t" ]; then
    rm -f "$t" "$probe"; HUSK_PROBE=symlink; probe_cache_put "$cf" "$ck"; return 0
  fi
  rm -f "$t"
  # Windows: no symlink privilege, but a junction links directories anyway.
  # Probed with a directory because that is all a junction can point at, and
  # all husk ever points at.
  if mkdir -p "$storefs/.husk-jprobe.$$" 2>/dev/null; then
    if make_junction "$t" "$storefs/.husk-jprobe.$$"; then
      rm -f "$t"; rmdir "$storefs/.husk-jprobe.$$" 2>/dev/null
      rm -f "$probe"; HUSK_PROBE=symlink; probe_cache_put "$cf" "$ck"; return 0
    fi
    rm -f "$t" 2>/dev/null; rm -rf "$t" 2>/dev/null
    rmdir "$storefs/.husk-jprobe.$$" 2>/dev/null
  fi
  rm -f "$t" "$probe"
  HUSK_PROBE=copy
}

probe_cache_put() { # cachefile key -> record $HUSK_PROBE for this filesystem pair
  # A short append, so concurrent writers interleave whole lines rather than
  # tearing one; a duplicate line is harmless because the first match wins.
  [ -n "$1" ] || return 0
  printf '%s\t%s\n' "$HUSK_PROBE" "$2" >> "$1" 2>/dev/null || true
}
probe_mode() { set_probe_mode "$1" "$2"; printf '%s' "$HUSK_PROBE"; }

# ---------- store compression ----------
# A store entry is written once and then only read. That is the exact shape
# transparent filesystem compression wants, and it is why husk can compress the
# store when nothing can safely compress a working tree.
#
# The win MULTIPLIES with sharing instead of competing with it: a hardlink farm
# and a CoW clone both point at the same bytes, so compressing one entry
# compresses every worktree provisioned from it, at no per-worktree cost.
# Measured on NTFS against a 21,004-file node_modules: 423 MB of data stored in
# 59 MB, and a `cp -al` farm of it reports the same ratio.
#
# Nothing here is ever load-bearing for correctness. Every tool is probed
# against the real store path, an unsupported filesystem lands on "none", and
# an entry that fails to compress is simply an entry that stays big.
HUSK_CBEFORE=0; HUSK_CAFTER=0
HUSK_CTOOL=""   # "" untested, else wof|btrfs|afsctool|none

compress_probe_bytes() { # file -> ~256K of compressible text (real deps are text)
  local i=0
  : > "$1" || return 1
  while [ "$i" -lt 512 ]; do
    printf '"use strict"; Object.defineProperty(exports, "__esModule", { value: true }); function transform(input, options) { return input; }\n' >> "$1"
    i=$((i + 1))
  done
}

HUSK_DU_APPARENT=-1
logical_kb() { # path -> apparent KB, or nothing if this du cannot report it
  # GNU du (Linux, and Git Bash's coreutils) has --apparent-size; BSD du does
  # not, and there is no portable substitute that does not cost a stat per file
  # on a 21,000-file tree. So the field is printed where it can be measured and
  # omitted where it cannot, rather than guessed.
  if [ "$HUSK_DU_APPARENT" = -1 ]; then
    if du -sk --apparent-size . >/dev/null 2>&1; then HUSK_DU_APPARENT=1; else HUSK_DU_APPARENT=0; fi
  fi
  [ "$HUSK_DU_APPARENT" = 1 ] || return 1
  du -sk --apparent-size "$1" 2>/dev/null | awk '{print $1; exit}'
}

phys_kb() { # path -> kilobytes actually consumed on disk (not apparent size)
  # st_blocks, which every one of these tools makes tell the truth: NTFS WOF
  # reports the compressed extent, btrfs reports compressed extents, and APFS
  # decmpfs reports the compressed resource. `du` is the portable reader.
  du -sk "$1" 2>/dev/null | awk '{print $1; exit}'
}

compress_apply() { # tool dir -> 0 if the tool ran; says nothing about the result
  case "$1" in
    wof)
      # /exe:LZX is write-once compression: a write to a compressed file simply
      # decompresses it. For an immutable store entry that is not a limitation,
      # it is the whole point, and it is the best ratio Windows will give.
      #
      # MSYS_NO_PATHCONV: Git Bash rewrites any argument that looks like a
      # POSIX path before the exe sees it, so a bare `/c` arrives as `C:\` and
      # compact silently LISTS the volume instead of compressing anything. It
      # reports success while doing nothing, which is the worst failure shape
      # available, and it is why the probe insists on seeing blocks actually
      # drop rather than trusting an exit code.
      local w
      w=$(cygpath -w "$2" 2>/dev/null) || return 1
      MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' \
        compact.exe /c /s:"$w" /i /q /exe:LZX >/dev/null 2>&1 || return 1 ;;
    btrfs)
      # +c marks the directory: NEW writes into it are compressed. Existing
      # files are not rewritten, which is why husk marks a staging dir BEFORE
      # filling it (see compress_stage) as well as marking published entries.
      chattr +c "$2" >/dev/null 2>&1 || return 1 ;;
    afsctool)
      afsctool -c "$2" >/dev/null 2>&1 || return 1 ;;
    *) return 1 ;;
  esac
  return 0
}

compress_stage() { # staging dir -> compress a not-yet-published entry, if asked to
  # Default is OFF on this path, and that is a deliberate choice rather than
  # timidity: seeding already copies the whole tree, and compressing it there
  # would land the cost on whichever `husk add` happens to be first, which is
  # exactly the command the last round of work spent itself making fast.
  # `husk compress` (or HUSK_COMPRESS=1) puts the cost where the user asked
  # for it. See the README's Compression section for the measured numbers.
  case "${HUSK_COMPRESS:-auto}" in
    1|yes|on) ;;
    *) return 0 ;;
  esac
  set_store_base
  set_compress_tool "$HUSK_SB"
  [ "$HUSK_CTOOL" = none ] && return 0
  compress_apply "$HUSK_CTOOL" "$1" || note "compress: $HUSK_CTOOL declined this entry, storing it uncompressed"
  return 0
}

set_compress_tool() { # dir -> $HUSK_CTOOL, probed against the filesystem dir lives on
  [ -n "$HUSK_CTOOL" ] && return 0
  case "${HUSK_COMPRESS:-auto}" in 0) HUSK_CTOOL=none; return 0 ;; esac

  local dir="$1" p f before after logical sig cf ctool ckey
  mkdir -p "$dir" 2>/dev/null || { HUSK_CTOOL=none; return 0; }

  # Disk cache, same asymmetry as the mode probe: only a POSITIVE answer is
  # cached. A stale positive costs one failed compress and nothing else; a
  # stale "none" would silently stop compressing forever.
  if [ "${HUSK_PROBE_CACHE:-1}" = "1" ]; then
    set_repo_common_dir; cf="$HUSK_RCD/husk-compress-cache"
    if [ -f "$cf" ]; then
      while IFS=$HUSK_TAB read -r ctool ckey; do
        if [ "$ckey" = "$dir" ]; then HUSK_CTOOL=$ctool; return 0; fi
      done < "$cf"
    fi
  else
    cf=""
  fi

  p="$dir/.husk-cprobe.$$"
  rm -rf "$p" 2>/dev/null
  mkdir -p "$p" 2>/dev/null || { HUSK_CTOOL=none; return 0; }
  f="$p/probe"

  for ctool in wof btrfs afsctool; do
    case "$ctool" in
      wof)      [ "$HUSK_HAVE_CYGPATH" = 1 ] && command -v compact.exe >/dev/null 2>&1 || continue ;;
      btrfs)    command -v chattr >/dev/null 2>&1 || continue ;;
      afsctool) command -v afsctool >/dev/null 2>&1 || continue ;;
    esac
    # btrfs compresses on write, so the mark has to precede the bytes; the
    # others compress in place afterwards. Cover both by marking, writing,
    # then applying, and judging only the result.
    [ "$ctool" = btrfs ] && { compress_apply btrfs "$p" || continue; }
    compress_probe_bytes "$f" || continue
    before=$(phys_kb "$f")
    logical=$(wc -c < "$f" 2>/dev/null)
    sig=$(sha256 < "$f" 2>/dev/null)
    [ "$ctool" = btrfs ] || compress_apply "$ctool" "$p" || continue
    after=$(phys_kb "$f")
    # Two questions, and a tool has to pass both: did the bytes on disk
    # actually shrink, and does the file still read back byte for byte? A
    # compressor that changes what husk hands to a build is worse than none.
    if [ -n "$before" ] && [ -n "$after" ] && [ "$after" -lt "$before" ] \
       && [ "$(wc -c < "$f" 2>/dev/null)" = "$logical" ] \
       && [ "$(sha256 < "$f" 2>/dev/null)" = "$sig" ]; then
      HUSK_CTOOL=$ctool
      rm -rf "$p" 2>/dev/null
      [ -n "$cf" ] && printf '%s\t%s\n' "$HUSK_CTOOL" "$dir" >> "$cf" 2>/dev/null
      return 0
    fi
    rm -f "$f" 2>/dev/null
  done

  rm -rf "$p" 2>/dev/null
  HUSK_CTOOL=none
}

# ---------- worktree state (.husk/state: dir<TAB>key<TAB>mode) ----------
set_state_file() { HUSK_SF="$1/.husk/state"; }   # root -> $HUSK_SF
state_file() { printf '%s/.husk/state' "$1"; }

set_state_get() { # root dir -> $HUSK_REC, "key mode" or empty
  # A three-column lookup in a file with a handful of rows does not need awk,
  # and `rec=$(state_get ...)` cost a fork on top of the exec.
  local sf d k m
  HUSK_REC=""
  set_state_file "$1"; sf=$HUSK_SF
  [ -f "$sf" ] || return 0
  while IFS=$HUSK_TAB read -r d k m; do
    if [ "$d" = "$2" ]; then HUSK_REC="$k $m"; return 0; fi
  done < "$sf"
}
state_get() { set_state_get "$1" "$2"; printf '%s' "$HUSK_REC"; }

state_set() { # root dir key mode
  # read-filter-rewrite under the state lock: two concurrent husk processes
  # updating DIFFERENT dirs in the same worktree must not lose each other's
  # row (a lost row makes gc think the entry is unreferenced)
  local root="$1" sf tmp lock
  set_state_file "$root"; sf=$HUSK_SF; tmp="$sf.tmp.$$"
  mkdir -p "$root/.husk"
  lock="$sf.lock"
  acquire_lock "$lock"
  { [ -f "$sf" ] && awk -F'\t' -v d="$2" '$1!=d' "$sf"; printf '%s\t%s\t%s\n' "$2" "$3" "$4"; } > "$tmp"
  mv "$tmp" "$sf"
  release_lock "$lock"
}

state_del() { # root dir
  local root="$1" sf tmp lock
  set_state_file "$root"; sf=$HUSK_SF; [ -f "$sf" ] || return 0
  tmp="$sf.tmp.$$"
  lock="$sf.lock"
  acquire_lock "$lock"
  awk -F'\t' -v d="$2" '$1!=d' "$sf" > "$tmp" && mv "$tmp" "$sf"
  release_lock "$lock"
}

add_ref() { # entry worktree-root
  # Read loop rather than `grep -qxF`: the ref list is one line per worktree and
  # this runs on every link, so it is not worth a process.
  local refs="$1.refs" line
  if [ -f "$refs" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      [ "$line" = "$2" ] && return 0
    done < "$refs"
  fi
  printf '%s\n' "$2" >> "$refs"
}

del_ref() { # entry worktree-root
  local refs="$1.refs" tmp
  [ -f "$refs" ] || return 0
  tmp="$refs.tmp.$$"
  grep -vxF "$2" "$refs" > "$tmp" 2>/dev/null || true
  mv "$tmp" "$refs"
}

# ---------- store dedupe ----------
# Entries for the same dir under different lockfile keys are mostly identical
# (one dep bump changes a handful of packages). Hardlink byte-identical files
# across entries so the store pays only for what actually changed. Safe because
# store entries are immutable after seeding: provisioning clones/copies OUT of
# them, and symlink mode write-guards the entry root.
nearest_sibling() { # entry -> newest sibling entry for the same dir, or empty
  local entry="$1" parent d best="" bm=0 m
  dir_of "$entry"; parent=$HUSK_DIRN
  for d in "$parent"/*; do
    [ -d "$d" ] || continue
    [ "$d" = "$entry" ] && continue
    case "$d" in *.tmp.*|*.lock) continue ;; esac
    m=$(mtime_of "$d" 2>/dev/null || echo 0)
    if [ "$m" -gt "$bm" ]; then bm=$m; best=$d; fi
  done
  printf '%s' "$best"
}

tree_sig() { # tree -> sorted "hash<TAB>perms<TAB>relpath" lines (two batched passes, O(1) forks)
  local tree="$1" th tp
  th=$(mktemp "${TMPDIR:-/tmp}/husk-sig.XXXXXX") || return 1
  tp=$(mktemp "${TMPDIR:-/tmp}/husk-sig.XXXXXX") || { rm -f "$th"; return 1; }
  ( cd "$tree" && find . -type f ! -name '.husk-*' -print0 | batch_hash ) \
    | awk '{h=$1; sub(/^[^ ]+ [ *]?/,""); print $0 "\t" h}' > "$th"
  ( cd "$tree" && batch_perms . ) \
    | awk '{p=$1; sub(/^[^ ]+ /,""); print $0 "\t" p}' > "$tp"
  awk -F'\t' 'NR==FNR{p[$1]=$2;next} ($1 in p){print $2 "\t" p[$1] "\t" $1}' "$tp" "$th" | LC_ALL=C sort
  rm -f "$th" "$tp"
}

sig_file_for() { # tree -> path to a signature file, caching as .husk-manifest when writable
  local tree="$1" mf="$1/.husk-manifest" tmp t
  [ -f "$mf" ] && { printf '%s' "$mf"; return 0; }
  tmp="$mf.tmp.$$"
  if tree_sig "$tree" > "$tmp" 2>/dev/null && mv "$tmp" "$mf" 2>/dev/null; then
    printf '%s' "$mf"; return 0
  fi
  rm -f "$tmp" 2>/dev/null
  t=$(mktemp "${TMPDIR:-/tmp}/husk-sig.XXXXXX") || return 1
  tree_sig "$tree" > "$t" && printf '%s' "$t"
}

batch_link() { # listfile srcdir dstdir -> replace listed "./rel" paths with hardlinks, in bulk
  # perl: one process, one link(2) per file (cpio/pax fork-free too but ~50x slower on macOS)
  if command -v perl >/dev/null 2>&1; then
    perl -e '
      my ($list, $src, $dst) = @ARGV;
      open my $fh, "<", $list or exit 1;
      while (<$fh>) { chomp; next unless length;
        unlink "$dst/$_"; link "$src/$_", "$dst/$_"; }
    ' "$1" "$2" "$3" 2>/dev/null && return 0
  fi
  ( cd "$3" && tr '\n' '\0' < "$1" | xargs -0 rm -f -- ) 2>/dev/null
  if command -v cpio >/dev/null 2>&1; then
    ( cd "$2" && cpio -pdl "$3" < "$1" ) 2>/dev/null && return 0
  fi
  ( cd "$2" && pax -rwl "$3" < "$1" ) 2>/dev/null
}

dedupe_entry() { # entry sibling [live] -> hardlink files with identical hash+perms+relpath
  local entry="$1" sib="$2" live="${3:-0}" esig ssig list n=0 have rel f s guarded=0 linked=0
  esig=$(sig_file_for "$entry") || return 0
  ssig=$(sig_file_for "$sib")   || return 0
  list=$(mktemp "${TMPDIR:-/tmp}/husk-dd.XXXXXX") || return 0
  LC_ALL=C comm -12 "$esig" "$ssig" 2>/dev/null | cut -f3 > "$list"
  n=$(grep -c . "$list" || true)
  if [ "$n" -eq 0 ]; then rm -f "$list"; return 0; fi
  if [ "$live" = "0" ]; then
    # unpublished tmp entry, no readers: bulk replace-with-hardlink (O(1) forks),
    # then heal any miss from the sibling (same content by definition)
    batch_link "$list" "$sib" "$entry" || true
    have=$( (cd "$entry" && tr '\n' '\0' < "$list" | xargs -0 ls -d -- 2>/dev/null | grep -c .) || true )
    if [ "${have:-0}" -ne "$n" ]; then
      while IFS= read -r rel; do
        [ -n "$rel" ] && [ ! -f "$entry/$rel" ] || continue
        ln "$sib/$rel" "$entry/$rel" 2>/dev/null || cp -p "$sib/$rel" "$entry/$rel" 2>/dev/null || true
      done < "$list"
    fi
  else
    # published entry, possible concurrent readers: atomic per-file swap.
    # A symlink-mode entry root is write-guarded (a-w); lift it just for the
    # swap so root-level files can dedupe too, then restore the guard.
    if [ ! -w "$entry" ]; then guarded=1; chmod u+w "$entry" 2>/dev/null || true; fi
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      f="$entry/$rel"; s="$sib/$rel"
      [ -f "$f" ] && [ ! -L "$f" ] && [ -f "$s" ] && [ ! -L "$s" ] || continue
      ln "$s" "$f.husk-dd.$$" 2>/dev/null || continue
      if mv -f "$f.husk-dd.$$" "$f" 2>/dev/null; then linked=$((linked+1)); else rm -f "$f.husk-dd.$$"; fi
    done < "$list"
    if [ "$guarded" = 1 ]; then chmod a-w "$entry" 2>/dev/null || true; fi
    n=$linked   # report what actually happened, not the candidate count
  fi
  rm -f "$list"
  note "dedupe: $n files hardlinked to sibling entry"
  return 0
}

# ---------- seeding ----------
strip_meta() { # dir -> remove husk store metadata (must never ride along into a reseed
  # or a worktree: a stale inherited .husk-manifest would poison dedupe with old hashes)
  rm -f "$1/.husk-manifest" "$1/.husk-seeded" 2>/dev/null || true
}

publish_entry() { # tmp entry -> atomic publish; concede gracefully if entry appeared
  # rename(2) onto an existing non-empty dir fails with ENOTEMPTY, so a raced
  # double-publish can never nest one tmp dir INSIDE the winner's entry
  # (which is what a plain 'mv' does when the target dir already exists)
  local tmp="$1" entry="$2"
  if command -v perl >/dev/null 2>&1; then
    perl -e 'rename $ARGV[0], $ARGV[1] or exit 1' "$tmp" "$entry" 2>/dev/null && return 0
    [ -d "$entry" ] && { rm_rf_safe "$tmp"; return 0; }   # lost the race: winner's copy serves
  elif [ -d "$entry" ]; then
    rm_rf_safe "$tmp"; return 0
  fi
  mv "$tmp" "$entry"
}

seed_entry_locked() { # source-real-dir entry -> seeds; caller MUST hold the entry lock
  local src="$1" entry="$2" tmp sib
  [ -d "$entry" ] && return 0
  tmp="$entry.tmp.$$"
  HUSK_CLEAN_TMP="$tmp"
  rm_rf_safe "$tmp"
  if cow_clone "$src" "$tmp"; then :; else plain_copy "$src" "$tmp"; fi
  strip_meta "$tmp"
  if [ "${HUSK_DEDUPE:-1}" = "1" ]; then
    sib=$(nearest_sibling "$entry")
    [ -n "$sib" ] && dedupe_entry "$tmp" "$sib"
  fi
  sig_file_for "$tmp" >/dev/null 2>&1 || true   # cache manifest for future siblings
  # Compress BEFORE publish: the staging tree is private, so there is no reader
  # to race and no lock to hold. After publish, an entry can be provisioned
  # from at any moment, and provisioning is deliberately lock-free.
  compress_stage "$tmp"
  now_ts; printf '%s\n' "$HUSK_NOW" > "$tmp/.husk-seeded" 2>/dev/null || true
  publish_entry "$tmp" "$entry"
  HUSK_CLEAN_TMP=""
}

seed_entry() { # source-real-dir entry -> seeds store entry atomically (no-op if exists)
  local src="$1" entry="$2" parent lock
  [ -d "$entry" ] && return 0
  dir_of "$entry"; parent=$HUSK_DIRN; mkdir -p "$parent"
  lock="$entry.lock"
  acquire_lock "$lock"
  if [ -d "$entry" ]; then release_lock "$lock"; return 0; fi  # raced, winner seeded
  seed_entry_locked "$src" "$entry"
  release_lock "$lock"
}

# ---------- provisioning ----------
swap_in() { # tmp target -> make tmp live at target, then discard the old tree.
  # Rename the old target ASIDE first (instant) instead of rm -rf'ing it
  # (seconds on a big tree): a crash mid-replace can no longer leave the
  # worktree with no dependency dir at all. doctor sweeps .husk-old residue.
  local tmp="$1" target="$2" old=""
  if [ -e "$target" ] || [ -L "$target" ]; then
    old="$target.husk-old.$$"
    rm_rf_safe "$old"
    mv "$target" "$old" 2>/dev/null || { rm_rf_safe "$target"; old=""; }
  fi
  mv "$tmp" "$target" || return 1
  [ -n "$old" ] && rm_rf_safe "$old"
  return 0
}

consume_prefarm() { # target entry mode -> 0 if the staged speculative tree was swapped in
  [ -n "${HUSK_PREFARM_TMP:-}" ] || return 1
  [ "$2" = "${HUSK_PREFARM_ENTRY:-}" ] || return 1
  [ "$3" = "${HUSK_PREFARM_MODE:-}" ] || return 1
  # the farm runs in cmd_add's shell, not ours: rendezvous on marker files
  local n=0
  while [ ! -e "$HUSK_PREFARM_TMP.done" ] && [ ! -e "$HUSK_PREFARM_TMP.failed" ]; do
    [ "$n" -ge 3000 ] && return 1
    sleep 0.1; n=$((n + 1))
  done
  [ -e "$HUSK_PREFARM_TMP.done" ] && [ -d "$HUSK_PREFARM_TMP" ] || return 1
  strip_meta "$HUSK_PREFARM_TMP"
  swap_in "$HUSK_PREFARM_TMP" "$1" || return 1
  chmod u+w "$1" 2>/dev/null || true
  return 0
}

provision() { # entry target mode
  local entry="$1" target="$2" mode="$3" tmp
  # in-use stamp: a brand-new worktree's ref+state are written only AFTER
  # provisioning, so a long copy from an old entry is invisible to gc's
  # refcheck. The stamp (sibling file, never inside the write-guarded entry)
  # buys the same 10-minute grace a fresh seed gets.
  now_ts; printf '%s\n' "$HUSK_NOW" > "$entry.used" 2>/dev/null || true
  case "$mode" in
    clone)
      consume_prefarm "$target" "$entry" "$mode" && return 0
      tmp="$target.husk-tmp.$$"
      HUSK_CLEAN_TMP="$tmp"
      rm_rf_safe "$tmp"
      cow_clone "$entry" "$tmp" || { rm_rf_safe "$tmp"; HUSK_CLEAN_TMP=""; return 1; }
      strip_meta "$tmp"
      swap_in "$tmp" "$target" || { rm_rf_safe "$tmp"; HUSK_CLEAN_TMP=""; return 1; }
      HUSK_CLEAN_TMP=""
      chmod u+w "$target" 2>/dev/null || true ;;   # private copy: undo inherited write guard
    hardlink)
      consume_prefarm "$target" "$entry" "$mode" && return 0
      tmp="$target.husk-tmp.$$"
      HUSK_CLEAN_TMP="$tmp"
      rm_rf_safe "$tmp"
      hardlink_farm "$entry" "$tmp" || { rm_rf_safe "$tmp"; HUSK_CLEAN_TMP=""; return 1; }
      strip_meta "$tmp"
      swap_in "$tmp" "$target" || { rm_rf_safe "$tmp"; HUSK_CLEAN_TMP=""; return 1; }
      HUSK_CLEAN_TMP=""
      chmod u+w "$target" 2>/dev/null || true ;;
    symlink)
      chmod a-w "$entry" 2>/dev/null || true   # write guard: installs via link fail loud (EACCES)
      tmp="$target.husk-tmp.$$"
      rm -f "$tmp"
      if ! { ln -s "$entry" "$tmp" 2>/dev/null && [ -L "$tmp" ]; }; then
        # MSYS/Git Bash without symlink privilege fakes 'ln -s' with a COPY.
        # Recording mode=symlink over a copy would claim sharing that isn't
        # happening (and drag store metadata into the worktree), so the fake is
        # thrown away and a junction -- the one directory link Windows grants
        # an unprivileged user -- is tried in its place.
        rm_rf_safe "$tmp"
        make_junction "$tmp" "$entry" || { rm_rf_safe "$tmp"; return 1; }
      fi
      swap_in "$tmp" "$target" || { rm -f "$tmp"; return 1; } ;;
    copy)
      tmp="$target.husk-tmp.$$"
      HUSK_CLEAN_TMP="$tmp"
      rm_rf_safe "$tmp"
      plain_copy "$entry" "$tmp" || { rm_rf_safe "$tmp"; HUSK_CLEAN_TMP=""; return 1; }
      strip_meta "$tmp"
      swap_in "$tmp" "$target" || { rm_rf_safe "$tmp"; HUSK_CLEAN_TMP=""; return 1; }
      HUSK_CLEAN_TMP=""
      chmod u+w "$target" 2>/dev/null || true ;;
    *) die "unknown mode: $mode" ;;
  esac
  # re-stamp on completion: a copy that itself took longer than gc's grace
  # would otherwise finish with an already-expired stamp
  now_ts; printf '%s\n' "$HUSK_NOW" > "$entry.used" 2>/dev/null || true
}

# ---------- installer detection ----------
run_install() { # root dir -> run the ecosystem's installer inside root
  local root="$1" dir="$2"
  ( cd "$root"
    case "$dir" in
      node_modules)
        if   [ -f pnpm-lock.yaml ];      then pnpm install --frozen-lockfile
        elif [ -f bun.lockb ] || [ -f bun.lock ]; then bun install --frozen-lockfile
        elif [ -f yarn.lock ];           then yarn install --immutable 2>/dev/null || yarn install --frozen-lockfile
        elif [ -f package-lock.json ] || [ -f npm-shrinkwrap.json ]; then npm ci
        elif [ -f package.json ];        then npm install
        else return 1; fi ;;
      .venv|venv)
        if   [ -f uv.lock ]; then uv sync
        elif [ -f poetry.lock ]; then poetry install
        elif [ -f requirements.txt ]; then python3 -m venv "$dir" && "./$dir/bin/pip" install -r requirements.txt
        else return 1; fi ;;
      *) note "no installer mapping for '$dir'; build it yourself, then re-run 'husk link'"; return 1 ;;
    esac )
}

# ---------- link (the core verb) ----------
link_one() { # root dir do_install -> exit 0 linked, 2 needs-install
  local root="$1" dir="$2" do_install="$3"
  local key entry mode donor target rec

  target="$root/$dir"
  set_key_for "$root" "$dir"; key=$HUSK_KEY
  if [ -z "$key" ]; then
    note "$dir: no lockfile or manifest to fingerprint; refusing to share (use your installer directly)"
    return 2
  fi
  set_entry_path "$dir" "$key"; entry=$HUSK_ENTRY
  # memoized: a multi-dir link pays one filesystem probe, not one per dir
  local pkey; set_store_base; pkey="$HUSK_MODE|$HUSK_SB|$root"
  if [ "$PROBE_CACHE_KEY" = "$pkey" ]; then
    mode=$PROBE_CACHE_VAL
  else
    set_probe_mode "$HUSK_SB" "$root"; mode=$HUSK_PROBE
    PROBE_CACHE_KEY=$pkey; PROBE_CACHE_VAL=$mode
  fi

  # idempotence: already linked to the right entry?
  set_state_get "$root" "$dir"; rec=$HUSK_REC
  if [ -n "$rec" ] && [ "${rec%% *}" = "$key" ]; then
    # -ef, not readlink: it costs no subshell, and MSYS resolves a junction
    # through its own mount table, so the same directory can read back under a
    # different spelling than the one husk wrote.
    if [ -L "$target" ] && [ -d "$entry" ] && [ "$target" -ef "$entry" ]; then
      out "linked dir=$dir mode=symlink key=$key entry=$entry (already)"
      return 0
    fi
    if [ ! -L "$target" ] && [ -d "$target" ] && [ -d "$entry" ] && [ "${rec##* }" != "symlink" ]; then
      out "linked dir=$dir mode=${rec##* } key=$key entry=$entry (already)"
      return 0
    fi
  fi

  # source of truth for seeding, in preference order:
  # 1. this worktree already has a real dir (agent ran the installer here).
  #    ONLY trusted when husk has no record for it (virgin install) or the record
  #    matches the current key - a recorded key mismatch means the dir is a stale
  #    relic of the OLD lockfile and must not seed the new key.
  if [ -d "$target" ] && [ ! -L "$target" ]; then
    if [ -z "$rec" ] || [ "${rec%% *}" = "$key" ]; then
      seed_entry "$target" "$entry"
    fi
  fi
  # 2. donor (main worktree) has a real dir whose lockfile matches ours
  if [ ! -d "$entry" ]; then
    set_main_worktree; donor=$HUSK_MAIN
    if [ -n "$donor" ] && [ "$donor" != "$root" ] && [ -d "$donor/$dir" ] && [ ! -L "$donor/$dir" ]; then
      set_key_for "$donor" "$dir"
      if [ "$HUSK_KEY" = "$key" ]; then
        seed_entry "$donor/$dir" "$entry"
      fi
    fi
  fi
  # 3. run the installer (opt-in), then seed from the result. Serialized under the
  # entry lock so N agents hitting a fresh lockfile run ONE installer, not N:
  # the winner installs + seeds, the rest wake to a ready entry and provision.
  if [ ! -d "$entry" ] && [ "$do_install" = "1" ]; then
    dir_of "$entry"; mkdir -p "$HUSK_DIRN"
    acquire_lock "$entry.lock"
    if [ ! -d "$entry" ]; then
      note "$dir: store miss; running installer"
      run_install "$root" "$dir" || die "$dir: installer failed"
      [ -d "$target" ] || die "$dir: installer did not produce $target"
      seed_entry_locked "$target" "$entry"
    fi
    release_lock "$entry.lock"
  fi

  if [ ! -d "$entry" ]; then
    out "miss dir=$dir key=$key"
    note "$dir: no store entry and no matching donor; run 'husk link --install', or install deps yourself then 'husk adopt' + 'husk link'"
    return 2
  fi

  # provision (skip when target IS the seed source and mode keeps real dirs:
  # a real dir that just seeded the store already shares blocks via CoW)
  if [ -d "$target" ] && [ ! -L "$target" ] && { [ "$mode" = "clone" ] || [ "$mode" = "hardlink" ]; }; then
    :
  else
    provision "$entry" "$target" "$mode" || {
      note "$dir: $mode provisioning failed; falling back to copy"
      mode=copy
      provision "$entry" "$target" "$mode" || die "$dir: provisioning failed (disk full?); worktree left without $dir"
    }
  fi

  state_set "$root" "$dir" "$key" "$mode"
  add_ref "$entry" "$root"
  exclude_husk_dir
  out "linked dir=$dir mode=$mode key=$key entry=$entry"
  return 0
}

cmd_link() {
  local do_install=0 dirs="" root rc=0 d
  while [ $# -gt 0 ]; do
    case "$1" in
      --install) do_install=1 ;;
      --mode) shift; HUSK_MODE="$1" ;;
      --mode=*) HUSK_MODE="${1#--mode=}" ;;
      -*) die "unknown flag for link: $1" ;;
      *) dirs="$dirs $1" ;;
    esac; shift
  done
  set_repo_root; root=$HUSK_RR; load_conf "$root"
  [ -n "${dirs// /}" ] || { set_detect_dirs "$root"; dirs=$HUSK_DEPDIRS; }
  [ -n "${dirs// /}" ] || { note "nothing to link (no known dependency dirs or lockfiles found)"; return 0; }
  local r
  for d in $dirs; do
    r=0; link_one "$root" "$d" "$do_install" || r=$?
    # severity: hard error (1) outranks needs-install (2) outranks ok,
    # regardless of the order the dirs were processed in
    case "$r:$rc" in *:1|1:*) rc=1 ;; *) [ "$r" -ne 0 ] && rc=$r ;; esac
  done
  return $rc
}

# ---------- add ----------
cmd_add() {
  local path="" branch="" extra="" install_flag=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --install) install_flag="--install" ;;
      --mode|--mode=*) case "$1" in --mode) shift; HUSK_MODE="$1";; *) HUSK_MODE="${1#--mode=}";; esac ;;
      -*) extra="$extra $1" ;;
      *) if [ -z "$path" ]; then path="$1"; elif [ -z "$branch" ]; then branch="$1"; else extra="$extra $1"; fi ;;
    esac; shift
  done
  [ -n "$path" ] || die "usage: husk add <path> [branch]"
  repo_root >/dev/null

  # speculative provision: farm the store entry for the CURRENT lockfile into
  # a staging dir WHILE git populates the worktree, so wall time approaches
  # max(checkout, farm) instead of checkout + farm. A new branch almost always
  # shares HEAD's lockfile, so the staged tree is almost always used; link_one
  # re-derives the key from the REAL checkout and consume_prefarm only accepts
  # the stage on an exact entry+mode match. Any mismatch (diverged lockfile,
  # different mode, farm failure) falls through to the normal sequential path.
  # Worst case is wasted work in the staging dir, never a wrong link.
  # HUSK_PREFARM=0 disables.
  local sroot sdir skey sentry smode sparent
  if [ "${HUSK_PREFARM:-1}" != "0" ]; then
    set_repo_root; sroot=$HUSK_RR; load_conf "$sroot"
    dir_of "$path"; sparent=$HUSK_DIRN
    if [ -d "$sparent" ]; then
      set_detect_dirs "$sroot"
      for sdir in $HUSK_DEPDIRS; do
        set_key_for "$sroot" "$sdir" || true; skey=$HUSK_KEY
        [ -n "$skey" ] || continue
        set_entry_path "$sdir" "$skey"; sentry=$HUSK_ENTRY
        [ -d "$sentry" ] || continue
        set_store_base; set_probe_mode "$HUSK_SB" "$sparent"; smode=$HUSK_PROBE
        case "$smode" in clone|hardlink) ;; *) continue ;; esac
        base_of "$path"; HUSK_PREFARM_TMP="$sparent/$HUSK_BASE.husk-pre.$$"
        rm_rf_safe "$HUSK_PREFARM_TMP"
        now_ts; printf '%s\n' "$HUSK_NOW" > "$sentry.used" 2>/dev/null || true
        if [ "$smode" = "clone" ]; then
          ( cow_clone "$sentry" "$HUSK_PREFARM_TMP" \
              && : > "$HUSK_PREFARM_TMP.done" || : > "$HUSK_PREFARM_TMP.failed" ) &
        else
          ( hardlink_farm "$sentry" "$HUSK_PREFARM_TMP" \
              && : > "$HUSK_PREFARM_TMP.done" || : > "$HUSK_PREFARM_TMP.failed" ) &
        fi
        HUSK_PREFARM_PID=$!
        HUSK_PREFARM_ENTRY="$sentry"
        HUSK_PREFARM_MODE="$smode"
        break   # one dir is the common case; the rest link sequentially
      done
    fi
  fi

  if [ -n "$branch" ]; then
    if git show-ref --verify --quiet "refs/heads/$branch"; then
      # shellcheck disable=SC2086
      git worktree add $extra "$path" "$branch"
    else
      # shellcheck disable=SC2086
      git worktree add $extra -b "$branch" "$path"
    fi
  else
    # shellcheck disable=SC2086
    git worktree add $extra "$path"
  fi

  # propagate the link result (2 = deps need install) instead of swallowing
  # it: agents key off exit 2 to run 'husk link --install'
  local link_rc=0
  # shellcheck disable=SC2086
  ( cd "$path" && cmd_link $install_flag ) || link_rc=$?
  # discard an unused stage (consume_prefarm mv'd it away if it was used)
  if [ -n "$HUSK_PREFARM_TMP" ]; then
    wait 2>/dev/null || true
    [ -e "$HUSK_PREFARM_TMP" ] && rm_rf_safe "$HUSK_PREFARM_TMP"
    rm -f "$HUSK_PREFARM_TMP.done" "$HUSK_PREFARM_TMP.failed" 2>/dev/null || true
    HUSK_PREFARM_TMP="" HUSK_PREFARM_PID=""
  fi
  set_abspath "$path"; out "worktree path=$HUSK_ABS"

  # Opportunistic reap nudge (no daemon; fleet stays bounded). The probe is a
  # full reap dry-run, which costs a handful of git invocations PER WORKTREE --
  # at the 20-100 worktrees husk is built for, that is the most expensive thing
  # `husk add` does, and it lands on whichever add happens to cross the window.
  # A stale-worktree hint is not time-critical, so the window is a day rather
  # than an hour: same warning, 24x less amortised cost. HUSK_NUDGE_SECS still
  # overrides it, and 0 forces the probe every time.
  local stale stamp nowts last
  set_repo_common_dir; stamp="$HUSK_RCD/husk-reap-probe"
  now_ts; nowts=$HUSK_NOW; last=$(cat "$stamp" 2>/dev/null || echo 0)
  case "$last" in *[!0-9]*|"") last=0 ;; esac
  if [ $((nowts - last)) -ge "${HUSK_NUDGE_SECS:-86400}" ]; then
    printf '%s' "$nowts" > "$stamp" 2>/dev/null || true
    stale=$(cmd_reap --dry-run --quiet | grep -c '^reap ' || true)
    [ "$stale" -gt 0 ] && note "$stale stale worktree(s) detected; run 'husk reap' to clean up"
  fi
  return $link_rc
}

# ---------- unlink (materialize private copy) ----------
cmd_unlink() {
  local root dirs="" d rec key mode entry target tmp
  set_repo_root; root=$HUSK_RR; load_conf "$root"
  set_state_file "$root"
  [ $# -gt 0 ] && dirs="$*" || dirs=$(awk -F'\t' '{print $1}' "$HUSK_SF" 2>/dev/null || true)
  [ -n "${dirs// /}" ] || { note "nothing linked"; return 0; }
  for d in $dirs; do
    set_state_get "$root" "$d"; rec=$HUSK_REC
    [ -n "$rec" ] || { note "$d: not linked, skipping"; continue; }
    key="${rec%% *}"; mode="${rec##* }"
    set_entry_path "$d" "$key"; entry=$HUSK_ENTRY
    target="$root/$d"
    if [ -L "$target" ]; then
      tmp="$target.husk-tmp.$$"
      rm_rf_safe "$tmp"
      if [ -d "$entry" ]; then
        cow_clone "$entry" "$tmp" || plain_copy "$entry" "$tmp"
      else
        note "$d: store entry gone; nothing to materialize from"
        rm -f "$target"; state_del "$root" "$d"; del_ref "$entry" "$root"
        out "unlinked dir=$d materialized=0"
        continue
      fi
      strip_meta "$tmp"
      rm -f "$target"; mv "$tmp" "$target"
    fi
    if [ ! -L "$target" ] && [ "$mode" = "hardlink" ] && [ -d "$target" ]; then
      # hardlink farm: every file still shares an inode with the store entry,
      # so a post-unlink in-place edit (>>, patch) would poison the store and
      # every sibling provisioned from it. "Stop sharing" must break the
      # links: rebuild from the CURRENT tree (local edits survive), CoW where
      # the filesystem has it, plain copy otherwise.
      tmp="$target.husk-tmp.$$"
      HUSK_CLEAN_TMP="$tmp"
      rm_rf_safe "$tmp"
      cow_clone "$target" "$tmp" || plain_copy "$target" "$tmp" \
        || { HUSK_CLEAN_TMP=""; die "$d: could not materialize private copy (disk full?)"; }
      strip_meta "$tmp"
      swap_in "$tmp" "$target" \
        || { rm_rf_safe "$tmp"; HUSK_CLEAN_TMP=""; die "$d: could not swap in private copy"; }
      HUSK_CLEAN_TMP=""
    fi
    [ -d "$target" ] && chmod u+w "$target" 2>/dev/null || true
    state_del "$root" "$d"
    del_ref "$entry" "$root"
    out "unlinked dir=$d materialized=1"
  done
}

# ---------- adopt (seed store from this checkout) ----------
cmd_adopt() {
  local root d key entry
  set_repo_root; root=$HUSK_RR; load_conf "$root"
  set_detect_dirs "$root"
  for d in $HUSK_DEPDIRS; do
    [ -d "$root/$d" ] && [ ! -L "$root/$d" ] || continue
    set_key_for "$root" "$d"; key=$HUSK_KEY
    [ -n "$key" ] || { note "$d: unfingerprintable, skipping"; continue; }
    set_entry_path "$d" "$key"; entry=$HUSK_ENTRY
    seed_entry "$root/$d" "$entry"
    out "adopted dir=$d key=$key entry=$entry"
  done
}

# ---------- status ----------
cmd_status() {
  local root sf base d key mode entry ok stale
  set_repo_root; root=$HUSK_RR; load_conf "$root"
  set_store_base; base=$HUSK_SB
  out "worktree=$root"
  out "store=$base"
  set_state_file "$root"; sf=$HUSK_SF
  if [ -f "$sf" ]; then
    while IFS=$HUSK_TAB read -r d key mode; do
      set_entry_path "$d" "$key"; entry=$HUSK_ENTRY
      ok=ok
      [ -d "$entry" ] || ok=missing-entry
      if [ "$mode" = "symlink" ] && [ ! -L "$root/$d" ]; then ok=not-a-link; fi
      if [ -L "$root/$d" ] && [ ! -e "$root/$d" ]; then ok=dangling; fi
      stale=""
      set_key_for "$root" "$d"
      [ "$HUSK_KEY" = "$key" ] || stale=" drift=lockfile-changed"
      out "dep dir=$d mode=$mode key=$key state=$ok$stale"
    done < "$sf"
  else
    out "dep none"
  fi
  if [ -d "$base" ]; then
    out "store_size=$(du -sh "$base" 2>/dev/null | cut -f1)"
    out "store_entries=$(find "$base" -mindepth 2 -maxdepth 2 -type d ! -name '*.lock' ! -name '*.tmp.*' 2>/dev/null | wc -l | tr -d ' ')"
  fi
}

# ---------- list (fleet view) ----------
# status answers "how is THIS worktree wired". With 20-100 worktrees the
# question is "how is the FLEET wired, and what is the sharing actually
# buying me". saved_mb is what a copy per worktree would have cost that the
# store does not: for an entry referenced by R worktrees, (R-1) x its size.
# Only sharing modes count; a copy-mode dir saves nothing and says so.
cmd_list() {
  local root base tmp wt branch sf d key mode entry st cnt size lsize cur live
  local n_wt=0 n_entries=0 total_saved=0 total_logical=0 store_mb=0 store_logical=0
  set_repo_root; root=$HUSK_RR; load_conf "$root"
  set_store_base; base=$HUSK_SB
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/husk-list.XXXXXX") || die "mktemp failed"
  HUSK_CLEAN_TMP="$tmp"

  git worktree list --porcelain 2>/dev/null \
    | sed -n 's/^worktree //p' | posix_path_stream > "$tmp/wts"
  while read -r wt; do
    [ -n "$wt" ] && [ -d "$wt" ] || continue
    n_wt=$((n_wt + 1))
    branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
    out "wt path=$wt branch=$branch"
    set_state_file "$wt"; sf=$HUSK_SF
    [ -f "$sf" ] || continue
    while IFS=$HUSK_TAB read -r d key mode; do
      [ -n "$d" ] || continue
      set_entry_path "$d" "$key"; entry=$HUSK_ENTRY
      st=ok; live=1
      [ -d "$entry" ] || { st=missing-entry; live=0; }
      [ -e "$wt/$d" ] || { st=missing-dir; live=0; }
      if [ "$mode" = "symlink" ] && [ ! -L "$wt/$d" ]; then st=not-a-link; live=0; fi
      # Drift means the lockfile moved on, not that sharing stopped: the dir is
      # still linked to the entry, so its bytes still count as saved. Report it,
      # but keep it a live reference. key_for is empty when the dir has no
      # fingerprint file, which is not drift either.
      set_key_for "$wt" "$d" 2>/dev/null || true; cur=$HUSK_KEY
      [ -z "$cur" ] || [ "$cur" = "$key" ] || st="$st drift=lockfile-changed"
      out "dep wt=$wt dir=$d mode=$mode key=$key state=$st"
      # only sharing modes dedupe bytes; a copy-mode dir saves nothing
      case "$mode" in
        clone|hardlink|symlink)
          if [ "$live" -eq 1 ]; then
            printf '%s\t%s\n' "$key" "$d" >> "$tmp/refs"
          fi ;;
      esac
    done < "$sf"
  done < "$tmp/wts"

  if [ -f "$tmp/refs" ]; then
    sort "$tmp/refs" | uniq -c > "$tmp/counts"
    # 'd' takes the rest of the line, so dep dirs containing spaces survive
    while read -r cnt key d; do
      [ -n "$key" ] || continue
      set_entry_path "$d" "$key"; entry=$HUSK_ENTRY
      [ -d "$entry" ] || continue
      size=$(du -sk "$entry" 2>/dev/null | cut -f1)
      case "$size" in ''|*[!0-9]*) size=0 ;; esac
      n_entries=$((n_entries + 1))
      total_saved=$((total_saved + size * (cnt - 1) / 1024))
      # size_mb/saved_mb are PHYSICAL and stay exactly as they were: stdout is
      # an API. What physical alone cannot say is what compression bought, so
      # the logical size and the two halves of the saving are added alongside.
      lsize=$(logical_kb "$entry" 2>/dev/null) || lsize=""
      if [ -n "$lsize" ] && [ "$lsize" -ge "$size" ]; then
        total_logical=$((total_logical + lsize))
        out "entry dir=$d key=$key refs=$cnt size_mb=$((size / 1024)) saved_mb=$((size * (cnt - 1) / 1024)) logical_mb=$((lsize / 1024)) saved_sharing_mb=$((lsize * (cnt - 1) / 1024)) saved_compression_mb=$(( (lsize - size) / 1024 ))"
      else
        out "entry dir=$d key=$key refs=$cnt size_mb=$((size / 1024)) saved_mb=$((size * (cnt - 1) / 1024))"
      fi
    done < "$tmp/counts"
  fi

  if [ -d "$base" ]; then
    store_mb=$(du -sk "$base" 2>/dev/null | cut -f1)
    case "$store_mb" in ''|*[!0-9]*) store_mb=0 ;; esac
    store_mb=$((store_mb / 1024))
  fi
  store_logical=$(logical_kb "$base" 2>/dev/null) || store_logical=""
  if [ -n "$store_logical" ] && [ "$total_logical" -gt 0 ]; then
    out "summary worktrees=$n_wt entries=$n_entries store_mb=$store_mb saved_mb=$total_saved store_physical_mb=$store_mb store_logical_mb=$((store_logical / 1024))"
  else
    out "summary worktrees=$n_wt entries=$n_entries store_mb=$store_mb saved_mb=$total_saved store_physical_mb=$store_mb"
  fi
  rm -rf "$tmp"; HUSK_CLEAN_TMP=""
}

# ---------- doctor ----------
cmd_doctor() {
  local fix=0 root sf d key mode entry base issues=0
  [ "${1:-}" = "--fix" ] && fix=1
  set_repo_root; root=$HUSK_RR; load_conf "$root"
  set_store_base; base=$HUSK_SB
  set_state_file "$root"; sf=$HUSK_SF
  if [ -f "$sf" ]; then
    while IFS=$HUSK_TAB read -r d key mode; do
      set_entry_path "$d" "$key"; entry=$HUSK_ENTRY
      # dangling link
      if [ -L "$root/$d" ] && [ ! -e "$root/$d" ]; then
        issues=$((issues+1))
        if [ $fix -eq 1 ]; then
          note "$d: dangling link; re-linking (mode $mode)"
          rm -f "$root/$d"; state_del "$root" "$d"
          ( cd "$root" && cmd_link --mode "$mode" "$d" ) || note "$d: re-link failed (store entry gone? try --install)"
        else
          out "issue dir=$d kind=dangling-link fix='husk doctor --fix'"
        fi
      fi
      # lockfile drift
      set_key_for "$root" "$d"
      if [ -n "$key" ] && [ "$HUSK_KEY" != "$key" ]; then
        issues=$((issues+1))
        if [ $fix -eq 1 ]; then
          note "$d: lockfile drifted; re-keying (mode $mode)"
          ( cd "$root" && cmd_link --mode "$mode" "$d" ) || true
        else
          out "issue dir=$d kind=lockfile-drift fix='husk link $d' (re-key) or 'husk unlink $d' (go private)"
        fi
      fi
    done < "$sf"
  fi
  # stale locks in store
  local lock pid
  for lock in "$base"/*/*.lock; do
    [ -d "$lock" ] || continue
    pid=$(cat "$lock/pid" 2>/dev/null || echo "")
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
      issues=$((issues+1))
      if [ $fix -eq 1 ]; then
        note "removing stale lock: $lock"
        steal_lock "$lock" "$pid" || true   # rename+verify: never wipes a lock a live process just took
      else out "issue kind=stale-lock path=$lock fix='husk doctor --fix'"; fi
    fi
  done
  # orphaned tmp residue from an interrupted seed (store), provision or
  # replace (worktree), or live-dedupe swap (store, .husk-dd files).
  # The pid is baked into the name; skip residue whose owner is still running.
  local tmpd
  for tmpd in "$base"/*/*.tmp.* "$root"/*.husk-tmp.* "$root"/*.husk-old.* \
              "$root"/../*.husk-pre.*; do
    [ -e "$tmpd" ] || [ -L "$tmpd" ] || continue
    pid=${tmpd##*.}
    case "$pid" in *[!0-9]*|'') pid="" ;; esac
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && continue
    issues=$((issues+1))
    if [ $fix -eq 1 ]; then
      note "removing orphaned tmp: $tmpd"
      if [ -L "$tmpd" ]; then rm -f "$tmpd"; else rm_rf_safe "$tmpd"; fi
    else out "issue kind=tmp-residue path=$tmpd fix='husk doctor --fix'"; fi
  done
  # live-dedupe swap residue can sit at any depth inside a store entry
  while IFS= read -r tmpd; do
    [ -n "$tmpd" ] || continue
    pid=${tmpd##*.}
    case "$pid" in *[!0-9]*|'') pid="" ;; esac
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && continue
    issues=$((issues+1))
    if [ $fix -eq 1 ]; then note "removing dedupe residue: $tmpd"; rm -f "$tmpd"
    else out "issue kind=tmp-residue path=$tmpd fix='husk doctor --fix'"; fi
  done <<DDRES
$(find "$base" -name '*.husk-dd.*' -type f 2>/dev/null)
DDRES
  [ $issues -eq 0 ] && out "doctor ok=1" || out "doctor issues=$issues fixed=$fix"
}

# ---------- reap (stale worktree cleanup) ----------
default_branch() {
  local b
  b=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null | sed 's@.*/@@') || true
  [ -n "${b:-}" ] && { printf '%s' "$b"; return 0; }
  for b in main master; do
    git show-ref --verify --quiet "refs/heads/$b" && { printf '%s' "$b"; return 0; }
  done
  git symbolic-ref --short HEAD 2>/dev/null || printf 'main'
}

cmd_reap() {
  local dry=0 quiet=0 days="$HUSK_REAP_DAYS" root main def now wt br head idx age merged gone reason
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1 ;;
      --quiet) quiet=1 ;;
      --days) shift; days="$1" ;;
      --days=*) days="${1#--days=}" ;;
      *) die "unknown flag for reap: $1" ;;
    esac; shift
  done
  set_repo_root; root=$HUSK_RR; load_conf "$root"
  set_main_worktree; main=$HUSK_MAIN; def=$(default_branch); now_ts; now=$HUSK_NOW

  git worktree list --porcelain | awk '/^worktree /{print substr($0,10)}' | posix_path_stream | while read -r wt; do
    [ "$wt" = "$main" ] && continue
    [ "$wt" = "$root" ] && continue                       # never reap where we stand
    [ -d "$wt" ] || continue
    # AGE FIRST, deliberately. `git status --porcelain` stats the entire working
    # tree, which is the most expensive question asked here, and the answer is
    # irrelevant for a worktree that is too young to reap. Since most of a fleet
    # is young most of the time, checking age first skips the tree walk for
    # nearly every worktree.
    #
    # Age = max(worktree HEAD-file mtime, last commit time). NOT the index
    # mtime, which any `git status` refreshes.
    idx=$(git -C "$wt" rev-parse --git-dir 2>/dev/null | posix_path_stream)
    [ -n "$idx" ] || idx="$wt/.git"
    local act1 act2 activity
    act1=$(mtime_of "$idx/HEAD" 2>/dev/null || echo "$now")
    act2=$(git -C "$wt" log -1 --format=%ct 2>/dev/null || echo "$now")
    activity=$act1; [ "$act2" -gt "$activity" ] && activity=$act2
    age=$(( (now - activity) / 86400 ))
    [ "$age" -lt "$days" ] && continue
    # clean?
    if [ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]; then continue; fi
    # merged or upstream gone?
    br=$(git -C "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
    head=$(git -C "$wt" rev-parse HEAD 2>/dev/null || echo "")
    merged=0; gone=0
    [ -n "$head" ] && git merge-base --is-ancestor "$head" "refs/heads/$def" 2>/dev/null && merged=1
    if [ -n "$br" ] && [ -n "$(git config "branch.$br.remote" 2>/dev/null || true)" ]; then
      git -C "$wt" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1 || gone=1
    fi
    [ $merged -eq 1 ] || [ $gone -eq 1 ] || continue
    reason=merged; [ $gone -eq 1 ] && reason=upstream-gone
    if [ $dry -eq 1 ]; then
      out "reap worktree=$wt branch=${br:-detached} reason=$reason age_days=$age"
    else
      [ $quiet -eq 0 ] && note "reaping $wt (${br:-detached}, $reason, ${age}d idle)"
      # deref store entries this worktree used
      local sf d k _m e
      set_state_file "$wt"; sf=$HUSK_SF
      if [ -f "$sf" ]; then
        while IFS=$HUSK_TAB read -r d k _m; do
          set_entry_path "$d" "$k"; del_ref "$HUSK_ENTRY" "$wt"
        done < "$sf"
      fi
      git worktree remove --force "$wt" 2>/dev/null || git worktree remove "$wt"
      [ -n "$br" ] && [ "$br" != "$def" ] && git branch -d "$br" 2>/dev/null || true
      out "reaped worktree=$wt branch=${br:-detached} reason=$reason"
    fi
  done
  return 0
}

# ---------- gc (drop unreferenced store entries) ----------
wt_uses_key() { # worktree key -> 0 if the worktree's state records this key
  set_state_file "$1"
  [ -d "$1" ] && [ -f "$HUSK_SF" ] \
    && awk -F'\t' -v k="$2" '$2==k{found=1} END{exit !found}' "$HUSK_SF" 2>/dev/null
}

cmd_gc() {
  local dry=0 base entry refs live wt freed key now seeded used wt_list
  [ "${1:-}" = "--dry-run" ] && dry=1
  set_store_base; base=$HUSK_SB
  [ -d "$base" ] || { out "gc entries=0"; return 0; }
  now_ts; now=$HUSK_NOW
  # authoritative consumers: this repo's actual worktrees. The .refs files are
  # advisory only - a process killed between state_set and add_ref leaves a
  # live worktree with no ref, and trusting refs alone would delete an entry
  # that worktree's symlink still points into.
  wt_list=$(git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | posix_path_stream)
  find "$base" -mindepth 2 -maxdepth 2 -type d ! -name '*.lock' ! -name '*.tmp.*' | while read -r entry; do
    # never touch an entry mid-seed (lock held) or younger than 10 minutes:
    # a sibling 'husk link' may have seeded it but not yet written its ref
    [ -d "$entry.lock" ] && continue
    seeded=$(cat "$entry/.husk-seeded" 2>/dev/null || echo 0)
    case "$seeded" in *[!0-9]*|"") seeded=0 ;; esac
    [ $((now - seeded)) -lt 600 ] && continue
    # ...or provisioned FROM recently: the consuming worktree's ref+state
    # land only after the copy finishes, so honor the in-use stamp too
    used=$(cat "$entry.used" 2>/dev/null || echo 0)
    case "$used" in *[!0-9]*|"") used=0 ;; esac
    [ $((now - used)) -lt 600 ] && continue
    refs="$entry.refs"
    base_of "$entry"; key=$HUSK_BASE
    live=0
    if [ -f "$refs" ]; then
      while read -r wt; do
        wt_uses_key "$wt" "$key" && live=$((live+1))
      done < "$refs"
    fi
    if [ "$live" -eq 0 ] && [ -n "$wt_list" ]; then
      while IFS= read -r wt; do
        if wt_uses_key "$wt" "$key"; then
          live=1
          add_ref "$entry" "$wt"   # heal the missing ref while we're here
          break
        fi
      done <<WTS
$wt_list
WTS
    fi
    if [ "$live" -eq 0 ]; then
      freed=$(du -sh "$entry" 2>/dev/null | cut -f1)
      if [ $dry -eq 1 ]; then
        out "gc-candidate entry=$entry size=$freed"
      else
        # claim the entry lock (non-blocking: busy means a seeder owns it) and
        # re-check the grace stamps UNDER the lock - a provision that started
        # after our first look re-stamps .used and must not lose its source.
        # If gc dies mid-delete the dead-pid lock is stolen/swept later.
        mkdir "$entry.lock" 2>/dev/null || continue
        echo $$ > "$entry.lock/pid"
        used=$(cat "$entry.used" 2>/dev/null || echo 0)
        case "$used" in *[!0-9]*|"") used=0 ;; esac
        seeded=$(cat "$entry/.husk-seeded" 2>/dev/null || echo 0)
        case "$seeded" in *[!0-9]*|"") seeded=0 ;; esac
        now_ts; now=$HUSK_NOW
        if [ $((now - used)) -lt 600 ] || [ $((now - seeded)) -lt 600 ]; then
          rm -rf "$entry.lock"; continue
        fi
        chmod -R u+w "$entry" 2>/dev/null || true
        rm -rf "$entry" "$refs" "$entry.used"
        rm -rf "$entry.lock"
        out "gc-removed entry=$entry size=$freed"
      fi
    fi
  done
  return 0
}

# ---------- dedupe (share identical files across existing store entries) ----------
cmd_dedupe() {
  local base dirp entry prev root dp en
  set_repo_root; root=$HUSK_RR; load_conf "$root"
  set_store_base; base=$HUSK_SB
  [ -d "$base" ] || { out "dedupe entries=0"; return 0; }
  for dirp in "$base"/*; do
    [ -d "$dirp" ] || continue
    prev=""
    # oldest -> newest so later entries link back to earlier inodes
    while IFS= read -r entry; do
      [ -n "$entry" ] && [ -d "$entry" ] || continue
      case "$entry" in *.tmp.*|*.lock) continue ;; esac
      if [ -n "$prev" ]; then
        base_of "$dirp"; dp=$HUSK_BASE; base_of "$entry"; en=$HUSK_BASE; base_of "$prev"
        note "dedupe: $dp/$en vs $HUSK_BASE"
        dedupe_entry "$entry" "$prev" 1
      fi
      prev="$entry"
    done <<EOF
$(find "$dirp" -mindepth 1 -maxdepth 1 -type d -exec sh -c 'if stat -f "%m %N" "$1" >/dev/null 2>&1; then stat -f "%m %N" "$1"; else stat -c "%Y %n" "$1"; fi' _ {} \; 2>/dev/null | sort -n | cut -d' ' -f2-)
EOF
  done
  out "dedupe done=1"
}

compress_entry() { # entry -> 0 if it shrank, 1 otherwise; never destructive
  local entry="$1" before after
  before=$(phys_kb "$entry"); [ -n "$before" ] || return 1
  compress_apply "$HUSK_CTOOL" "$entry" || return 1
  after=$(phys_kb "$entry"); [ -n "$after" ] || return 1
  [ "$after" -lt "$before" ] || return 1
  HUSK_CBEFORE=$((HUSK_CBEFORE + before))
  HUSK_CAFTER=$((HUSK_CAFTER + after))
  return 0
}

cmd_compress() { # [--probe] [--dry-run]
  local base dirp entry root probe=0 dry=0 n=0 skipped=0 lock
  while [ $# -gt 0 ]; do
    case "$1" in
      --probe)   probe=1 ;;
      --dry-run) dry=1 ;;
      *) die "compress: unknown option: $1" ;;
    esac
    shift
  done
  set_repo_root; root=$HUSK_RR; load_conf "$root"
  set_store_base; base=$HUSK_SB
  set_compress_tool "$base"
  out "compress=$HUSK_CTOOL"
  if [ "$probe" = 1 ]; then
    case "$HUSK_CTOOL" in
      none) note "no store compression available here (nothing installed that this filesystem accepts)" ;;
      *)    note "store compression available via $HUSK_CTOOL" ;;
    esac
    return 0
  fi
  [ "$HUSK_CTOOL" = none ] && { out "compressed=0"; out "skipped=0"; return 0; }
  [ -d "$base" ] || { out "compressed=0"; out "skipped=0"; return 0; }

  HUSK_CBEFORE=0; HUSK_CAFTER=0
  for dirp in "$base"/*; do
    [ -d "$dirp" ] || continue
    for entry in "$dirp"/*; do
      [ -d "$entry" ] || continue
      case "$entry" in *.tmp.*|*.lock) continue ;; esac
      # An entry mid-seed is being WRITTEN, and compressing a tree under a
      # writer is how a good idea becomes a corrupt store. Its lock says so.
      lock="$entry.lock"
      if [ -d "$lock" ]; then skipped=$((skipped + 1)); continue; fi
      if [ "$dry" = 1 ]; then n=$((n + 1)); continue; fi
      if compress_entry "$entry"; then n=$((n + 1)); else skipped=$((skipped + 1)); fi
    done
  done
  out "compressed=$n"
  out "skipped=$skipped"
  if [ "$dry" = 0 ] && [ "$HUSK_CBEFORE" -gt 0 ]; then
    out "physical_before_kb=$HUSK_CBEFORE"
    out "physical_after_kb=$HUSK_CAFTER"
    if [ "$HUSK_CAFTER" -gt 0 ]; then
      out "ratio=$(awk -v a="$HUSK_CBEFORE" -v b="$HUSK_CAFTER" 'BEGIN { printf "%.1f", a/b }')"
    fi
  fi
}

# ---------- setup (agent adoption: adopt + instructions) ----------
agent_snippet() {
  cat <<'EOF'
<!-- husk:agent-instructions -->
## Worktrees (husk)
- Create worktrees with `husk add <path> <branch>` instead of `git worktree add`. Dependencies are provisioned instantly from a shared store.
- If any husk command exits with code 2, run `husk link --install` inside that worktree.
- After changing a lockfile and reinstalling deps, run `husk adopt` so sibling worktrees can share the result.
- Periodically run `husk reap` (removes only clean + merged + idle worktrees) and `husk gc`.
- `husk status` to inspect, `husk doctor --fix` to repair. Never delete `~/.husk/store`.
<!-- /husk:agent-instructions -->
EOF
}

cmd_setup() {
  local write=0 root target
  [ "${1:-}" = "--write" ] && write=1
  set_repo_root; root=$HUSK_RR; load_conf "$root"
  cmd_adopt
  if [ $write -eq 1 ]; then
    target="$root/AGENTS.md"
    [ ! -f "$target" ] && [ -f "$root/CLAUDE.md" ] && target="$root/CLAUDE.md"
    if [ -f "$target" ] && grep -q 'husk:agent-instructions' "$target"; then
      out "setup instructions=already-present file=$target"
    else
      { [ -f "$target" ] && [ -s "$target" ] && printf '\n'; agent_snippet; } >> "$target"
      out "setup instructions=written file=$target"
    fi
  else
    agent_snippet
    note "add the block above to your AGENTS.md / CLAUDE.md (or re-run: husk setup --write)"
  fi
}

# ---------- help ----------
usage() {
  cat <<'EOF'
husk - storage-efficient git worktrees (share heavy dependency dirs safely)

USAGE
  husk add <path> [branch] [--install] [--mode M]   create worktree + link deps (one verb)
  husk link [dir...] [--install] [--mode M]         link/provision dep dirs in current worktree
  husk unlink [dir...]                              materialize a private copy, stop sharing
  husk adopt                                        seed the store from this checkout's real dirs
  husk setup [--write]                              adopt + agent instructions (--write appends to AGENTS.md/CLAUDE.md)
  husk status                                       link states, drift, store size (this worktree)
  husk list                                         every worktree, its deps, and disk saved by sharing
  husk doctor [--fix]                               find/repair dangling links, drift, stale locks
  husk reap [--dry-run] [--days N]                  delete stale worktrees (clean+merged+idle)
  husk gc [--dry-run]                               drop unreferenced store entries
  husk dedupe                                       hardlink identical files across store entries
  husk compress [--probe] [--dry-run]               compress store entries in place (every sharer inherits it)
  husk version                                      print the husk version

MODES (--mode or HUSK_MODE; default: auto)
  auto      probe filesystem: clone > hardlink > symlink
  clone     CoW clone (APFS/btrfs/XFS) - full isolation, bytes shared until divergence
  hardlink  hardlink farm - file-level dedupe, near-full isolation
  symlink   link to shared store entry - maximal dedupe, shared writes (guarded read-only root)
            on Windows this is a directory junction, the one link an unprivileged user can make
  copy      plain copy - always correct, no savings

ENV
  HUSK_STORE      store location (default ~/.husk/store)
  HUSK_MODE       default mode (default auto)
  HUSK_REAP_DAYS  reap idle threshold (default 7)
  HUSK_DEDUPE     hardlink identical files across store entries at seed time (default 1)
  HUSK_COMPRESS   compress store entries: auto (only when asked) | 1 at seed time | 0 never
  HUSK_WINFARM    Windows: native CreateHardLinkW farm, 0 to force the portable chain (default 1)
  HUSK_JUNCTION   Windows: allow directory junctions for symlink mode (default 1)

Config file: .husk.conf at repo root. KEY=VALUE lines, parsed and never sourced, so a
  cloned repo cannot run code on 'husk add'. Example: HUSK_DIRS=node_modules .venv
Output: stdout is stable key=value lines; humans read stderr.
Exit codes: 0 ok - 2 needs install - 1 error
EOF
}

# ---------- main ----------
main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    link)    cmd_link "$@" ;;
    add)     cmd_add "$@" ;;
    unlink)  cmd_unlink "$@" ;;
    adopt)   cmd_adopt "$@" ;;
    setup)   cmd_setup "$@" ;;
    status)  cmd_status "$@" ;;
    list)    cmd_list "$@" ;;
    doctor)  cmd_doctor "$@" ;;
    reap)    cmd_reap "$@" ;;
    gc)      cmd_gc "$@" ;;
    dedupe)  cmd_dedupe "$@" ;;
    compress) cmd_compress "$@" ;;
    version|--version) out "husk $HUSK_VERSION" ;;
    ""|help|--help|-h) usage ;;
    *) die "unknown command: $cmd (try 'husk --help')" ;;
  esac
}

main "$@"
